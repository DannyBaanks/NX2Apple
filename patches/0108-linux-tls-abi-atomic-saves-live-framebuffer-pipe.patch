+#include <fcntl.h>
 #include <signal.h>
+#include <sys/clonefile.h>
+#include <sys/stat.h>
 #include <sys/syscall.h>
 #include <unistd.h>
 
@@ -212,6 +216,39 @@ static void test_dispatch(void) {
     ok(good, "the queue runs the blocks in order, and dispatch_sync waits for them");
 }
 
+static void test_clonefile_and_swap(void) {
+    char base[128], src[192], dst[192], sub[256], f1[320], f2[320];
+    snprintf(base, sizeof base, "/tmp/dm-clone-test-%ld", (long)getpid());
+    snprintf(src, sizeof src, "%s/save", base);
+    snprintf(dst, sizeof dst, "%s/save.work", base);
+    snprintf(sub, sizeof sub, "%s/slot0", src);
+    snprintf(f1, sizeof f1, "%s/data.bin", sub);
+    mkdir(base, 0700);
+    mkdir(src, 0700);
+    mkdir(sub, 0700);
+    int fd = open(f1, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    const char payload[] = "LEAFGREEN_SAVE_V1";
+    ok(fd >= 0 && write(fd, payload, sizeof payload) == (ssize_t)sizeof payload, "create save fixture");
+    if (fd >= 0) close(fd);
+
+    ok(clonefile(src, dst, 0) == 0, "clonefile recursively clones a directory tree");
+    ok(clonefile(src, dst, 0) < 0 && errno == EEXIST, "clonefile refuses an existing destination");
+
+    snprintf(f2, sizeof f2, "%s/slot0/data.bin", dst);
+    char got[64] = {0};
