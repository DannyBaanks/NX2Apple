+LDLIBS += -lvulkan $(VULKAN_LIB)   # VULKAN_LIB: -L where the loader lives when it is not on the default path
+LDFLAGS := $(filter-out -static,$(LDFLAGS))
+else
+GFX_OUT = linux/nvn_vk.c linux/nvn_vk_pending.c linux/nvn_vk_replay.c   # the Vulkan layer is out of the headless build
