@@ -1212,6 +1215,139 @@ int removexattr(const char *path, const char *name, int options) {
     return (int)syscall(SYS_removexattr, path, name);
 }
 
+// ---- clonefile (recursive file & directory clone with FICLONE + copy fallback)
+//
+// hle_fs.c calls clonefile(dir, work, 0) on the save directory to stage a save transaction
+// before swapping with renamex_np(..., RENAME_SWAP). Linux's FICLONE only clones regular
+// files on reflink filesystems; this handles directories recursively and falls back to
+// buffered read/write copy when FICLONE is unsupported (e.g. ext4/tmpfs).
+static void clone_rm_tree(const char *path) {
+    struct stat st;
+    if (lstat(path, &st) < 0) return;
+    if (S_ISDIR(st.st_mode)) {
+        DIR *d = opendir(path);
+        if (d) {
+            struct dirent *de;
+            while ((de = readdir(d)) != NULL) {
+                if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+                char child[PATH_MAX];
+                if (snprintf(child, sizeof child, "%s/%s", path, de->d_name) < (int)sizeof child)
+                    clone_rm_tree(child);
+            }
+            closedir(d);
+        }
+        rmdir(path);
+    } else {
+        unlink(path);
+    }
+}
+
+static int clone_reg_file(const char *src, const char *dst, mode_t mode) {
+    int in = open(src, O_RDONLY | O_CLOEXEC);
+    if (in < 0) return -1;
+    int out = open(dst, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, mode & 0777);
+    if (out < 0) {
+        int e = errno;
+        close(in);
+        errno = e;
+        return -1;
+    }
+    int rc = 0;
+    if (ioctl(out, FICLONE, in) < 0) {
+        int fe = errno;
+        if (fe == EOPNOTSUPP || fe == ENOTSUP || fe == EXDEV || fe == EINVAL || fe == ENOSYS) {
+            uint8_t buf[65536];
+            for (;;) {
+                ssize_t n = read(in, buf, sizeof buf);
+                if (n == 0) break;
+                if (n < 0) {
+                    if (errno == EINTR) continue;
+                    rc = -1;
+                    break;
+                }
+                ssize_t off = 0;
+                while (off < n) {
+                    ssize_t w = write(out, buf + off, (size_t)(n - off));
+                    if (w < 0) {
+                        if (errno == EINTR) continue;
+                        rc = -1;
+                        break;
+                    }
+                    off += w;
+                }
+                if (rc < 0) break;
+            }
+        } else {
+            rc = -1;
+        }
+    }
+    int saved_err = errno;
+    close(in);
+    if (close(out) < 0 && rc == 0) {
+        rc = -1;
+        saved_err = errno;
+    }
+    if (rc < 0) {
+        unlink(dst);
+        errno = saved_err;
+    }
+    return rc;
+}
+
+int clonefile(const char *src, const char *dst, int flags) {
+    (void)flags;
+    if (!src || !dst) {
+        errno = EINVAL;
+        return -1;
+    }
+    struct stat st;
+    if (lstat(src, &st) < 0) return -1;
+    if (S_ISREG(st.st_mode)) return clone_reg_file(src, dst, st.st_mode);
+    if (S_ISLNK(st.st_mode)) {
+        char target[PATH_MAX];
+        ssize_t n = readlink(src, target, sizeof target - 1);
+        if (n < 0) return -1;
+        target[n] = '\0';
+        return symlink(target, dst);
+    }
+    if (!S_ISDIR(st.st_mode)) {
+        errno = ENOTSUP;
+        return -1;
+    }
+    if (mkdir(dst, (st.st_mode & 0777) | 0700) < 0) return -1;
+    DIR *d = opendir(src);
+    if (!d) {
+        int e = errno;
+        rmdir(dst);
+        errno = e;
+        return -1;
+    }
+    struct dirent *de;
+    int rc = 0;
+    int saved_err = 0;
+    while ((de = readdir(d)) != NULL) {
+        if (!strcmp(de->d_name, ".") || !strcmp(de->d_name, "..")) continue;
+        char s_child[PATH_MAX], d_child[PATH_MAX];
+        if (snprintf(s_child, sizeof s_child, "%s/%s", src, de->d_name) >= (int)sizeof s_child ||
+            snprintf(d_child, sizeof d_child, "%s/%s", dst, de->d_name) >= (int)sizeof d_child) {
+            rc = -1;
+            saved_err = ENAMETOOLONG;
+            break;
+        }
+        if (clonefile(s_child, d_child, flags) < 0) {
+            rc = -1;
+            saved_err = errno;
+            break;
+        }
+    }
+    closedir(d);
+    if (rc < 0) {
+        clone_rm_tree(dst);
+        errno = saved_err;
+    }
+    return rc;
+}
+
