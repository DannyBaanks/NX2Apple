+    if (fd >= 0) close(fd);
+    ok(n == (ssize_t)sizeof payload && memcmp(got, payload, sizeof payload) == 0, "cloned save file matches bytes");
+
+    ok(renamex_np(dst, src, RENAME_SWAP) == 0, "renamex_np RENAME_SWAP exchanges save directories");
+
+    unlink(f1); unlink(f2);
+    snprintf(sub, sizeof sub, "%s/slot0", dst); rmdir(sub);
+    snprintf(sub, sizeof sub, "%s/slot0", src); rmdir(sub);
+    rmdir(dst); rmdir(src); rmdir(base);
+}
+
 int main(void) {
     test_memory();
     test_sections();
@@ -220,6 +257,7 @@ int main(void) {
     test_threads();
     test_ucontext();
     test_dispatch();
+    test_clonefile_and_swap();
     fprintf(stderr, fails ? "\n[RED] %d failures\n" : "\nall ok\n", fails);
     return fails != 0;
 }
diff --git a/dm/host/linux/tests/t_linux_tls.c b/dm/host/linux/tests/t_linux_tls.c
new file mode 100644
index 0000000..384fe3b
--- /dev/null
+++ b/dm/host/linux/tests/t_linux_tls.c
@@ -0,0 +1,35 @@
+// Linux guest slots must be reachable from TP and isolated between host threads.
+#include <dm_linux.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+
+static pthread_key_t key;
+static uint64_t offset;
+static int failed;
+static uintptr_t read_slot(void) {
+    uintptr_t tp = (uintptr_t)__builtin_thread_pointer();
+    return *(uintptr_t *)(tp + offset);
+}
+static void *worker(void *unused) {
+    (void)unused;
+    if (read_slot() != 0 || dm_linux_key_offset(key) != offset) failed = 1;
+    if (pthread_setspecific(key, (void *)0x5678) || read_slot() != 0x5678) failed = 1;
+    if (pthread_getspecific(key) != (void *)0x5678) failed = 1;
+    return NULL;
+}
+int main(void) {
+    if (pthread_key_create(&key, NULL)) return 1;
+    offset = dm_linux_key_offset(key);
+    if (pthread_setspecific(key, (void *)0x1234) || read_slot() != 0x1234) return 1;
+    pthread_t th;
+    if (pthread_create(&th, NULL, worker, NULL)) return 1;
+    pthread_join(th, NULL);
+    if (failed || read_slot() != 0x1234) return 1;
+    *(uintptr_t *)((uintptr_t)__builtin_thread_pointer() + offset) = 0x9abc;
+    if (pthread_getspecific(key) != (void *)0x9abc) return 1;
+    if (pthread_setspecific(key, NULL) || read_slot() != 0) return 1;
+    pthread_key_delete(key);
+    puts("ok: Linux guest slots match pthread state and remain isolated across threads");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_nvn_vk.c b/dm/host/linux/tests/t_nvn_vk.c
new file mode 100644
index 0000000..b0268c3
--- /dev/null
+++ b/dm/host/linux/tests/t_nvn_vk.c
@@ -0,0 +1,76 @@
+// The Vulkan backend's own test: the floor the replay layer stands on.
+//
+// Four things, each one a property the build keeps: a pool is the guest's own memory and
+// mtl_addr finds it (and does not find what is outside it); a copy between two pools is
+// executed by the device, and the bytes are there after the fence says so; an offscreen
+// frame clears to the colour asked and reads back that colour in every pixel; and the
+// fence counters agree with each other.
+#include "nvn_vk.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fail(const char *what) { printf("FAIL: %s\n", what); return 1; }
+
+int main(void) {
+    mtl_init();
+    if (!mtl_vk_up()) {
+        printf("no device: the graphics stays on the stand-in (reported once, nothing pretended)\n");
+        return 0;
+    }
+
+    // the pools: 64 KiB each, the guest's own pages
+    void *src = malloc(65536), *dst = malloc(65536);
+    if (!src || !dst) return fail("memory");
+    mtl_pool_add(src, 65536);
+    mtl_pool_add(dst, 65536);
+    if (!mtl_addr_known((uint64_t)(uintptr_t)src)) return fail("the source pool is not known");
+    if (mtl_addr_known((uint64_t)(uintptr_t)src + 70000)) return fail("beyond the pool must not be known");
+    if (mtl_addr_known(0x1000)) return fail("an address outside every pool must not be known");
+    void *sb = NULL, *db = NULL;
+    uint64_t so = 0, doff = 0;
+    if (!mtl_addr((uint64_t)(uintptr_t)src, 4096, &sb, &so) || !sb || so) return fail("mtl_addr source");
+    if (!mtl_addr((uint64_t)(uintptr_t)dst, 4096, &db, &doff) || !db || doff) return fail("mtl_addr destination");
+    if (mtl_addr((uint64_t)(uintptr_t)src, 70000, &sb, &so)) return fail("mtl_addr must not span past the pool");
+
+    // a pattern only the device can have written there: the CPU copy stays zero until the
+    // copy the test asks for is done
+    memset(src, 0, 65536);
+    memset(dst, 0, 65536);
+    unsigned char pat[4096];
+    for (int i = 0; i < 4096; i++) pat[i] = (unsigned char)(i * 7 + 3);
+    // the pool's bytes, whichever way the driver holds them
+    unsigned char *sp = mtl_pool_ptr(src);
+    if (!sp) return fail("no pointer to the source pool");
+    memcpy(sp + 128, pat, sizeof pat);
+
+    mtl_sub_begin();
+    mtl_sub_copy((uint64_t)(uintptr_t)src + 128, (uint64_t)(uintptr_t)dst + 512, sizeof pat);
+    uint64_t fence = mtl_sub_commit();
+    if (!fence) return fail("the submit returned no fence");
+    if (!mtl_wait(fence)) return fail("the copy did not complete");
+    if (mtl_completed_fence() < fence || mtl_last_fence() < fence) return fail("the fence counters");
+    if (mtl_wait(fence + 1)) return fail("a fence that was never submitted cannot be complete");
+    unsigned char *dp = mtl_pool_ptr(dst);
+    if (!dp || memcmp(dp + 512, pat, sizeof pat)) return fail("the device's copy left different bytes");
+
+    // the offscreen frame: 64x48 in a colour the test picks, read back and checked
+    uint32_t rgba[4] = { 0x11, 0x22, 0x33, 0xff };
+    void *pixels = NULL;
+    size_t bytes = 0;
+    if (mtl_offscreen_frame(64, 48, rgba, &pixels, &bytes) < 0) return fail("the offscreen frame");
+    if (!pixels || bytes < (size_t)64 * 48 * 4) return fail("the readback is too small");
+    uint32_t want = 0xff332211u;   // R,G,B,A little endian, the order the bytes come back in
+    for (int i = 0; i < 64 * 48; i++) {
+        uint32_t got;
+        memcpy(&got, (char *)pixels + i * 4, 4);
+        if (got != want) return fail("a pixel is not the colour the clear asked for");
+    }
+
+    mtl_finish();
+    printf("ok: the device runs, mtl_addr maps the guest's memory, the device copies between pools, and the offscreen frame reads back\n");
+    mtl_shutdown();
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_nvn_vk_replay.c b/dm/host/linux/tests/t_nvn_vk_replay.c
new file mode 100644
index 0000000..048c46a
--- /dev/null
+++ b/dm/host/linux/tests/t_nvn_vk_replay.c
@@ -0,0 +1,276 @@
+// The replay's own test: a command buffer written exactly as hle_nvn.c writes it (the
+// {op, size} header of nvn_obj.h and the payload structs beside it), replayed on the
+// device, and the frame read back.
+//
+// What is checked is the whole path, not a helper: the records a game produces become the
+// pixels a screen would show. A clear to a colour comes back as that colour in every
+// pixel; a recording with no clear is reported rather than drawn; and an op this slice
+// does not replay yet stops the walk and names itself instead of being dropped.
+#include "nvn_vk_replay.h"
+
+#include "nvn_obj.h"
+#include "nvn_vk.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint8_t mem[65536];
+static size_t put;
+
+static void rec(uint32_t op, const void *payload, uint32_t n) {
+    op_hdr h = { op, (uint32_t)(sizeof h + n) };
+    memcpy(mem + put, &h, sizeof h);
+    if (n) memcpy(mem + put + sizeof h, payload, n);
+    put += sizeof h + n;
+}
+
+// A texture as hle_nvn.c lays it out: the shape is what the payload names.
+static tex_t make_tex(uint32_t w, uint32_t h) {
+    tex_t t;
+    memset(&t, 0, sizeof t);
+    t.magic = 0x54455830u;
+    t.d.width = w;
+    t.d.height = h;
+    t.d.target = 0;
+    t.d.format = 2;      // RGBA8
+    t.L.size = (uint64_t)w * h * 4; t.L.align = 1; t.L.layers = 1;
+    return t;
+}
+
+static int fail(const char *what) { printf("FAIL: %s\n", what); return 1; }
+
+// The shared pieces of the recordings: the target, the clear and the triangle.
+static tex_t tex;
+static p_set_rt mk_rt(void) { p_set_rt rt = { .n = 1, .color = { &tex, 0,0,0,0,0,0,0 }, .depth = NULL }; return rt; }
+static float rgba[4] = { 0.25f, 0.5f, 0.75f, 1.0f };
+static p_clear_color mk_clear(void) {
+    p_clear_color cl = { .index = 0, .mask = 0xf };
+    for (int i = 0; i < 4; i++) cl.rgba[i] = rgba[i];
+    return cl;
+}
+static uint32_t clear_bytes[4];
+static uint8_t guest[65536];
+static p_bind_vbuf mk_vbuf(void) {
+    float tri[3][2] = { { 0.0f, -0.6f }, { 0.6f, 0.6f }, { -0.6f, 0.6f } };
+    unsigned char *gp = mtl_pool_ptr(guest);   // the pool's bytes, whichever way the driver holds them
+    if (!gp) { fail("no pointer to the guest pool"); exit(1); }
+    memcpy(gp + 1024, tri, sizeof tri);
+    if (memcmp(gp + 1024, tri, sizeof tri)) { fail("the pool does not hold the vertices written to it"); exit(1); }
+    NVNbufferRange vr = { .address = (uint64_t)(uintptr_t)(guest + 1024), .size = sizeof tri };
+    p_bind_vbuf vb = { .first = 0, .n = 1 };
+    for (int i = 0; i < 16; i++) vb.r[i].address = 0, vb.r[i].size = 0;
+    vb.r[0] = vr;
+    return vb;
+}
+static p_viewports mk_vp(void) {
+    p_viewports vp = { .first = 0, .n = 1 };
+    vp.v[0][0] = 0; vp.v[0][1] = 0; vp.v[0][2] = 64; vp.v[0][3] = 48; vp.v[0][4] = 0; vp.v[0][5] = 1;
+    return vp;
+}
+static p_draw mk_draw(void) {
+    p_draw dr = { .prim = 0, .first = 0, .count = 3, .instances = 1, .base_instance = 0, .ind = 0, .mdi_cnt = 0, .mdi_i = -1 };
+    return dr;
+}
+
+int main(void) {
+    mtl_init();
+    if (!mtl_vk_up()) { printf("SKIP: no Vulkan device\n"); return 77; }
+    tex = make_tex(64, 48);
+    mtl_pool_add(guest, sizeof guest);
+    for (int i = 0; i < 4; i++) clear_bytes[i] = (uint32_t)(rgba[i] * 255 + 0.5);
+    p_set_rt rt = mk_rt();
+    p_clear_color cl = mk_clear();
+    p_bind_vbuf vb = mk_vbuf();
+    p_viewports vp = mk_vp();
+    p_draw dr = mk_draw();
+    uint32_t green = 0xff00ff00u;
+    void *pixels = NULL; size_t bytes = 0;
+    unsigned diff;
+
+    // 1. the draw, as this process's FIRST frame: the guest's vertices, bound from a pool,
+    // into the recorded target. A first frame is the cleanest state the layer can be in.
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_VIEWPORTS, &vp, sizeof vp);
+    rec(OP_BIND_VBUF, &vb, sizeof vb);
+    rec(OP_DRAW, &dr, sizeof dr);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) < 0) return fail("the draw recording did not replay");
+    if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+    { uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+      diff = 0;
+      for (int i = 0; i < 64 * 48; i++) { uint32_t v; memcpy(&v, (char *)pixels + i * 4, 4); if (v != expect_clear) diff++; } }
+    printf("distintos del clear: %u\n", diff);
+    if (!diff) return fail("the draw left no pixels of its own");
+    { uint32_t mid; memcpy(&mid, (char *)pixels + ((48 / 2) * 64 + 32) * 4, 4);
+      if (mid != green) return fail("the triangle is not where the draw put it"); }
+    { uint32_t corner; memcpy(&corner, (char *)pixels, 4);
+      uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+      if (corner != expect_clear) return fail("the clear did not stay outside the triangle"); }
+
+    // 2. the clear alone: the recorded clear replays to the pixels it names
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) < 0) return fail("the clear recording did not replay");
+    pixels = NULL; bytes = 0;
+    if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+    { uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+      for (int i = 0; i < 64 * 48; i++) { uint32_t v; memcpy(&v, (char *)pixels + i * 4, 4); if (v != expect_clear) return fail("a pixel is not the colour the recording cleared to"); } }
+
+    // 3. a recording that sets a target and never clears: reported, not drawn
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) < 0) return fail("a target with no clear must still replay to the end");
+
+    // 4. an op this slice does not replay yet (a sampler bind): the walk stops and names it
+    p_bind_handles bs = { .stage = 0, .first = 0, .n = 0, .defer = 0, .src = 0 };
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_BIND_SAMP, &bs, sizeof bs);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) == 0) return fail("an unimplemented op must stop the walk, not be dropped");
+    // 5. the inter-frame case: a clear-only frame FIRST, then a frame with a draw. This is
+    // the order a real game runs in (a clear pass, then the draws), so it must draw too.
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) < 0) return fail("the clear-first frame did not replay");
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_VIEWPORTS, &vp, sizeof vp);
+    rec(OP_BIND_VBUF, &vb, sizeof vb);
+    rec(OP_DRAW, &dr, sizeof dr);
+    rec(OP_END, NULL, 0);
+    if (rk_run(mem, mem + put) < 0) return fail("the draw-after-clear frame did not replay");
+    if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+    { uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+      diff = 0;
+      for (int i = 0; i < 64 * 48; i++) { uint32_t v; memcpy(&v, (char *)pixels + i * 4, 4); if (v != expect_clear) diff++; } }
+    printf("frame tras clear-only, pixeles propios: %u\n", diff);
+    if (!diff) return fail("the draw after a clear-only frame drew nothing");
+    // 6. the host's own entry: mtl_exec takes the recording's first record and nothing else
+    // (nvn_queue.inc: mtl_exec(n->bytes)), so the walk must follow it to OP_END by itself.
+    put = 0;
+    rec(OP_SET_RT, &rt, sizeof rt);
+    rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+    rec(OP_VIEWPORTS, &vp, sizeof vp);
+    rec(OP_BIND_VBUF, &vb, sizeof vb);
+    rec(OP_DRAW, &dr, sizeof dr);
+    rec(OP_END, NULL, 0);
+    mtl_exec(mem);   // the host calls it for its side effect: the frame it draws
+    if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+    { uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+      diff = 0;
+      for (int i = 0; i < 64 * 48; i++) { uint32_t v; memcpy(&v, (char *)pixels + i * 4, 4); if (v != expect_clear) diff++; } }
+    printf("por mtl_exec, pixeles propios: %u\n", diff);
+    if (!diff) return fail("the host's entry drew nothing");
+
+    // 7. an indexed draw: the index buffer is the guest's own memory too, and the same
+    // triangle comes out of four vertices and six indices.
+    {   unsigned char *gp2 = mtl_pool_ptr(guest);
+        float quad[4][2] = { { 0.0f, -0.6f }, { 0.6f, -0.6f }, { -0.6f, 0.6f }, { 0.6f, 0.6f } };
+        uint16_t idx[6] = { 0, 1, 2, 2, 1, 3 };
+        memcpy(gp2 + 2048, quad, sizeof quad);
+        memcpy(gp2 + 4096, idx, sizeof idx);
+        NVNbufferRange ivr = { .address = (uint64_t)(uintptr_t)(guest + 4096), .size = sizeof idx };
+        vs_st vss = { .stride = 8, .divisor = 0 };
+        va_st vas; uint32_t raw = 2u | (0u << 8) | (0u << 27);   // format RGBA32F? no: 2 = float, offset 0, stream 0
+        memcpy(&vas, &raw, sizeof vas);
+        p_bind_vstream bvs = { .first = 0, .n = 1 };
+        for (int i = 0; i < 16; i++) bvs.st[i] = vss;
+        p_bind_vattr bva = { .first = 0, .n = 1 };
+        for (int i = 0; i < 32; i++) bva.st[i] = 0;
+        bva.st[0] = raw;
+        p_bind_vbuf vb2 = mk_vbuf();
+        vb2.r[0].address = (uint64_t)(uintptr_t)(guest + 2048);
+        vb2.r[0].size = sizeof quad;
+        p_draw_idx di = { .prim = 0, .itype = 1, .count = 6, .base_vertex = 0, .base_instance = 0, .instances = 1, .ibuf = ivr.address, .ind = 0, .mdi_cnt = 0, .mdi_i = -1 };
+        put = 0;
+        rec(OP_SET_RT, &rt, sizeof rt);
+        rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+        rec(OP_VIEWPORTS, &vp, sizeof vp);
+        rec(OP_BIND_VSTREAM, &bvs, sizeof bvs);
+        rec(OP_BIND_VATTR, &bva, sizeof bva);
+        rec(OP_BIND_VBUF, &vb2, sizeof vb2);
+        rec(OP_DRAW_IDX, &di, sizeof di);
+        rec(OP_END, NULL, 0);
+        if (rk_run(mem, mem + put) < 0) return fail("the indexed recording failed");
+        if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+        { uint32_t expect_clear = (clear_bytes[3] << 24) | (clear_bytes[2] << 16) | (clear_bytes[1] << 8) | clear_bytes[0];
+          diff = 0;
+          for (int i = 0; i < 64 * 48; i++) { uint32_t v; memcpy(&v, (char *)pixels + i * 4, 4); if (v != expect_clear) diff++; } }
+        printf("draw indexado, pixeles propios: %u\n", diff);
+        if (!diff) return fail("the indexed draw drew nothing");
+    }
+
+    // 8. a textured draw: the texture's storage is the guest's own memory, the recording
+    // binds it by handle, and the pixel comes out as the texel the coordinates name.
+    {   unsigned char *gp3 = mtl_pool_ptr(guest);
+        uint32_t texels[4] = { 0xffff00ffu, 0xffff00ffu, 0xffff00ffu, 0xffff00ffu };
+        memcpy(gp3 + 8192, texels, sizeof texels);
+        tex_t tt; memset(&tt, 0, sizeof tt);
+        tt.magic = 0x54455830u;
+        tt.d.width = 2; tt.d.height = 2; tt.d.format = 2; tt.d.levels = 1; tt.d.target = 0;
+        tt.mem = guest + 8192; tt.off = 0; tt.pool = NULL;
+        tt.L.size = sizeof texels; tt.L.align = 1; tt.L.layers = 1;
+        view_t tv; memset(&tv, 0, sizeof tv);
+        mtl_reg_tex(7, &tt, &tv);
+        float quad_uv[6][4] = {
+            { -0.6f, -0.6f, 0.0f, 1.0f }, { 0.6f, -0.6f, 1.0f, 1.0f },
+            { -0.6f,  0.6f, 0.0f, 0.0f },
+            { -0.6f,  0.6f, 0.0f, 0.0f }, { 0.6f, -0.6f, 1.0f, 1.0f }, { 0.6f, 0.6f, 1.0f, 0.0f },
+        };
+        memcpy(gp3 + 16384, quad_uv, sizeof quad_uv);
+        p_bind_vbuf vb3 = mk_vbuf();
+        vb3.r[0].address = (uint64_t)(uintptr_t)(guest + 16384);
+        vb3.r[0].size = sizeof quad_uv;
+        p_bind_vstream bvs3 = { .first = 0, .n = 1 };
+        for (int i = 0; i < 16; i++) bvs3.st[i] = (vs_st){ .stride = 16, .divisor = 0 };
+        p_bind_vattr bva3 = { .first = 0, .n = 2 };
+        uint32_t a0 = 2u | (0u << 8) | (0u << 27);      // float, offset 0, stream 0
+        uint32_t a1 = 2u | (8u << 8) | (0u << 27);      // float, offset 8, stream 0
+        bva3.st[0] = a0; bva3.st[1] = a1;
+        p_bind_handles bt = { .stage = 0, .first = 0, .n = 1, .defer = 0, .src = 0 };
+        bt.h[0] = 7;                                    // texture ID 7, no sampler
+        p_draw dr3 = { .prim = 0, .first = 0, .count = 6, .instances = 1, .base_instance = 0, .ind = 0, .mdi_cnt = 0, .mdi_i = -1 };
+        put = 0;
+        rec(OP_SET_RT, &rt, sizeof rt);
+        rec(OP_CLEAR_COLOR, &cl, sizeof cl);
+        rec(OP_VIEWPORTS, &vp, sizeof vp);
+        rec(OP_BIND_VSTREAM, &bvs3, sizeof bvs3);
+        rec(OP_BIND_VATTR, &bva3, sizeof bva3);
+        rec(OP_BIND_VBUF, &vb3, sizeof vb3);
+        rec(OP_BIND_TEX, &bt, sizeof bt);
+        rec(OP_DRAW, &dr3, sizeof dr3);
+        rec(OP_END, NULL, 0);
+        if (rk_run(mem, mem + put) < 0) return fail("the textured recording failed");
+        if (mtl_offscreen_readback(&pixels, &bytes) < 0) return fail("the readback");
+        { uint32_t mid; memcpy(&mid, (char *)pixels + (24 * 64 + 32) * 4, 4);
+          printf("textura en el centro: %08x\n", mid);
+          if (mid != 0xffff00ffu)
+              return fail("the sampled pixel is not the texture's magenta texel"); }
+    }
+
+    const char *image = getenv("DM_TEST_IMAGE");
+    if (image && *image) {
+        FILE *out = fopen(image, "wb");
+        if (!out) return fail("cannot write the frame image");
+        fprintf(out, "P6\n64 48\n255\n");
+        for (int i = 0; i < 64 * 48; i++) {
+            if (fwrite((char *)pixels + i * 4, 1, 3, out) != 3) { fclose(out); return fail("frame image write"); }
+        }
+        if (fclose(out)) return fail("frame image close");
+    }
+    printf("ok: the recorded draw replays to the pixels it names, the clear stays put, an op this slice lacks stops the walk, and the host's own entry replays too\n");
+    mtl_shutdown();
+    return 0;
+}
