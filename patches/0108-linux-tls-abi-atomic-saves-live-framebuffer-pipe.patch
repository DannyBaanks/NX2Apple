+    uint8_t ng = swz_pick((uint8_t)((swz >> 3) & 7u), r, g, b, a);
+    uint8_t nb = swz_pick((uint8_t)((swz >> 6) & 7u), r, g, b, a);
+    uint8_t na = swz_pick((uint8_t)((swz >> 9) & 7u), r, g, b, a);
