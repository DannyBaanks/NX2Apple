+++ b/dm/host/linux/nvn_vk_builtin_spv.h
@@ -0,0 +1,68 @@
+// The built-in pipeline's shaders, for the first slice of the replay: a vertex that
+// takes its position from the bound vertex buffer and a colour from a push constant,
+// and a fragment that writes it. The game's own shaders come from the shader chain
+// (SPIR-V from dmsh_xlate); this is the floor that proves the path, and it is the
+// same words a translated shader would arrive as.
+#pragma once
+
+#include <stdint.h>
+
+// DM_SPV_TRI_VERT: generated from tri.vert.spv with glslangValidator -V (not hand-written)
+static const uint32_t DM_SPV_TRI_VERT[] = {
+    0x07230203u, 0x00010300u, 0x0008000bu, 0x0000001du, 0x00000000u, 0x00020011u, 0x00000001u, 0x0006000bu,
