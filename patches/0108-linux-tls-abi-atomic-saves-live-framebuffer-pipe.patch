diff --git a/dm/host/linux/nvn_vk_replay.c b/dm/host/linux/nvn_vk_replay.c
new file mode 100644
index 0000000..39aaa5f
--- /dev/null
+++ b/dm/host/linux/nvn_vk_replay.c
@@ -0,0 +1,279 @@
+// The NVN replay layer on Vulkan: the command buffer the interface layer (hle_nvn.c)
+// records, executed by the device.
+//
+// The Metal replay (nvn_mtl.m) walks the recorded operations and makes the same Metal
+// calls in the same order. This is that walk for the Linux backend: the record format is
+// the host's own ({op, size} header plus the payload of nvn_obj.h), and each op becomes
+// the Vulkan work it names. What is not here yet reports and stops the walk, the way the
+// Metal replay's missing selector does: no recorded op can be silently dropped.
+//
+// The first slice is the one every frame starts with: set the render targets and clear
+// them. It is verifiable on its own — a command buffer that clears to a colour comes back
+// as that colour in every pixel — and it is the shape every later op takes.
+#include "nvn_vk_replay.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <vulkan/vulkan.h>
+
+#include "nvn_obj.h"
+#include "nvn_vk.h"
+
+#define RK_LOG(...) do { fprintf(stderr, "[dm] [linux] [vk] [replay] " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+struct rk {
+    VkClearColorValue clear[8];
+    uint32_t clear_mask;                    // which attachments carry a clear this pass
+    int has_rt;
+    uint32_t w, h;
+    uint64_t ops_done;
+    int stopped;                            // an op this slice does not implement: the walk ends and says so
+    uint32_t stopped_op;
+    uint64_t steps;
+    // the draw state this slice carries, and the draws it accumulates for the frame
+    void *vbuf; uint64_t voff;                  // the last bound vertex buffer, from the guest's pool
+    float vp_x, vp_y, vp_w, vp_h; int vp_set;   // the recorded viewport
+    p_scissor sc; int sc_set;                   // the recorded scissor
+    uint32_t vstride[16]; va_st vattr[32];      // the recorded streams and attributes
+    uint32_t tex;                              // the handle the recording bound last
+    const void *prog;
+    uint32_t draw_rgba[4];                      // the colour the built-in pipeline draws with
+    vk_draw draws[16]; unsigned ndraws;
+};
+
+static struct rk R;
+
+// The render target set: one colour attachment for now (p_set_rt's colour[0]), with the
+// picture's shape taken from it. Depth is noted and not yet drawn through.
+static int op_set_rt(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_set_rt)) return -1;
+    const p_set_rt *p = payload;
+    if (!p->n || !p->color[0]) { r->has_rt = 0; return 0; }   // no target: nothing to draw into
+    const tex_t *t = p->color[0];
+    r->w = t->d.width;
+    r->h = t->d.height;
+    r->has_rt = 1;
+    r->clear_mask = 0;
+    r->ndraws = 0;
+    return 0;
+}
+
+// The clear colour, as the attachment's pixels come back: R,G,B,A little endian.
+static int op_clear_color(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_clear_color)) return -1;
+    const p_clear_color *p = payload;
+    if (p->index >= 8) return -1;
+    // the recording carries the colour as floats; the attachment takes 8-bit channels
+    for (int i = 0; i < 4; i++) {
+        float v = p->rgba[i];
+        r->clear[p->index].uint32[i] = (uint32_t)(v <= 0.f ? 0 : v >= 1.f ? 255 : v * 255.f + 0.5f);
+    }
+    r->clear_mask |= 1u << p->index;
+    return 0;
+}
+
+// The draw state this slice carries: the last bound vertex buffer and the colour the
+// built-in pipeline draws with, then the frame's frames.
+static int op_viewports(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_viewports)) return -1;
+    const p_viewports *p = payload;
+    if (p->n < 1) return 0;   // no viewport: the pipeline's default (the whole target) stands
+    r->vp_x = p->v[0][0]; r->vp_y = p->v[0][1]; r->vp_w = p->v[0][2]; r->vp_h = p->v[0][3];
+    r->vp_set = 1;
+    return 0;
+}
+
+static int op_scissor(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_scissor)) return -1;
+    const p_scissor *p = payload;
+    if (p->w <= 0 || p->h <= 0) return 0;
+    r->sc = *p;
+    r->sc_set = 1;
+    return 0;
+}
+
+// The vertex buffer the game bound: its address is the guest's, and it lives in a pool the
+// host registered, so the device buffer and the offset come from there.
+static int op_bind_vbuf(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_bind_vbuf)) return -1;
+    const p_bind_vbuf *p = payload;
+    if (p->n < 1) return 0;
+    const NVNbufferRange *br = &p->r[0];
+    r->vbuf = NULL; r->voff = 0;
+    if (br->size) {
+        void *buf = NULL; uint64_t off = 0;
+        if (mtl_addr(br->address, br->size, &buf, &off)) { r->vbuf = buf; r->voff = off; }
+        else RK_LOG("a vertex buffer at %#llx is outside every pool", (unsigned long long)br->address);
+    }
+    return 0;
+}
+
+// The program: the game's own shaders come from the shader chain; until the translation
+// lands, the built-in pipeline draws, and the log says so once per run.
+static int said_builtin;
+static int op_bind_program(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_bind_program)) return -1;
+    const p_bind_program *p = payload;
+    if (p->prog) { r->prog = p->prog; }
+    if (!said_builtin) { said_builtin = 1; RK_LOG("the built-in pipeline draws: the game's shaders are not translated yet"); }
+    return 0;
+}
+
+// The vertex streams and attributes: the built-in pipeline has one binding (0) with a
+// stride of 8 and one attribute (a vec2 at offset 0), so a recording that asks for
+// something else is reported rather than drawn as if it were this.
+static int said_attr;
+static int op_bind_vstream(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_bind_vstream)) return -1;
+    const p_bind_vstream *p = payload;
+    for (int32_t i = 0; i < p->n && i < 16; i++) r->vstride[i] = p->st[i].stride;
+    return 0;
+}
+
+static int op_bind_vattr(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_bind_vattr)) return -1;
+    const p_bind_vattr *p = payload;
+    for (int32_t i = 0; i < p->n && i < 32; i++) {
+        va_st a; memcpy(&a, &p->st[i], sizeof a);
+        if (a.stream >= 16) continue;
+        r->vattr[i] = a;
+    }
+    return 0;
+}
+
+static int op_draw_idx(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_draw_idx)) return -1;
+    const p_draw_idx *p = payload;
+    if (r->ndraws >= 16) { RK_LOG("more than 16 draws in a frame: this slice stops at 16"); return -1; }
+    // the index buffer: the guest's own memory, as the vertex buffer is
+    void *ib = NULL; uint64_t io = 0;
+    if (p->itype < 1 || p->itype > 2 || p->count <= 0 || p->ind || p->mdi_cnt || p->instances != 1) {
+        RK_LOG("this slice requires a direct 16-bit or 32-bit indexed draw with one instance"); return -1;
+    }
+    uint64_t index_bytes = (uint64_t)p->count * (p->itype == 1 ? 2u : 4u);
+    if (p->ibuf && !mtl_addr(p->ibuf, index_bytes, &ib, &io)) { RK_LOG("an index buffer at %#llx is outside every pool", (unsigned long long)p->ibuf); return -1; }
+    if (!ib) { RK_LOG("a draw with no index buffer bound: nothing to draw"); return -1; }
+    vk_draw *d = &r->draws[r->ndraws++];
+    d->vbuf = r->vbuf;
+    d->off = r->voff;
+    d->first = 0;
+    d->count = (uint32_t)(p->count > 0 ? p->count : 0);
+    d->rgba = NULL;
+    d->ibuf = ib;
+    d->ioff = io;
+    d->itype = p->itype;              // NVNindexType: 0 = byte, 1 = short, 2 = int
+    d->base_vertex = p->base_vertex;
+    d->tex = r->tex;
+    return 0;
+}
+
+// The texture bound for the next draws: the record carries the handle (texture ID |
+// sampler ID << 20), and the object registry the host fills at registration time is what
+// turns it into an image.
+static int op_bind_tex(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_bind_handles)) return -1;
+    const p_bind_handles *p = payload;
+    if (p->n > 0 && p->h[0]) r->tex = (uint32_t)p->h[0];
+    return 0;
+}
+
+static int op_draw(struct rk *r, const void *payload, uint32_t size) {
+    if (size < sizeof(p_draw)) return -1;
+    const p_draw *p = payload;
+    if (r->ndraws >= 16) { RK_LOG("more than 16 draws in a frame: this slice stops at 16"); return -1; }
+    vk_draw *d = &r->draws[r->ndraws++];
+    d->vbuf = r->vbuf;
+    d->off = r->voff;
+    d->first = (uint32_t)(p->first < 0 ? 0 : p->first);
+    d->count = (uint32_t)(p->count > 0 ? p->count : 0);
+    d->rgba = r->draw_rgba;
+    d->tex = r->tex;
+    return 0;
+}
+
+int rk_walk(struct rk *r, const uint8_t *begin, const uint8_t *end);
+// segments are followed through their JUMPs. An op this slice does not implement stops the
+// walk and names itself, so a caller cannot believe work happened that did not.
+int rk_run(const uint8_t *begin, const uint8_t *end) {
+    memset(&R, 0, sizeof R);
+    R.has_rt = 0;
+    R.steps = 0;   // the walk's own bound: a recording that never ends cannot hang here
+    R.draw_rgba[0] = R.draw_rgba[1] = R.draw_rgba[2] = R.draw_rgba[3] = 255;   // white until a program says otherwise
+    for (int i = 0; i < 16; i++) R.vstride[i] = 8;   // the built-in pipeline's own binding, until a recording says otherwise
+    int rc = rk_walk(&R, begin, end);
+    if (rc < 0) return -1;
+    if (R.steps > 1000000) { RK_LOG("a recording of more than a million records: the walk stops"); return -1; }
+    if (R.stopped) { RK_LOG("an op this slice does not replay yet was recorded (op %u after %llu ops)", R.stopped_op, (unsigned long long)R.ops_done); return -1; }
+    // the frame: the clear recorded first, then each draw in order, into the offscreen
+    if (R.has_rt) {
+        if (R.ndraws) RK_LOG("draw 0: vbuf=%p off=%llu first=%u count=%u rgba=%p", R.draws[0].vbuf, (unsigned long long)R.draws[0].off, R.draws[0].first, R.draws[0].count, (void*)R.draws[0].rgba);
+        int textured = 0;
+        for (unsigned i = 0; i < R.ndraws; i++) if (R.draws[i].tex) textured = 1;
+        if (textured) {
+            if (mtl_offscreen_textured(R.w, R.h, R.clear[0].uint32, R.draws, R.ndraws, NULL, NULL) < 0) return -1;
+        } else if (mtl_offscreen_draw(R.w, R.h, R.clear[0].uint32, R.draws, R.ndraws, NULL, NULL) < 0) return -1;
+        return 0;
+    }
+    RK_LOG("no render target was set: nothing was drawn");
+    return 0;
+}
+
+// The host's own entry points (nvn_obj.h): a command handle is the recording's first
+// record, and the walk follows it until OP_END, as the Metal replay does. end is a safety
+// bound when the caller has one.
+void mtl_exec(const uint8_t *handle) { rk_run(handle, NULL); }
+void mtl_exec_rest(const uint64_t *handles, int n) { for (int i = 0; i < n; i++) rk_run((const uint8_t *)(uintptr_t)handles[i], NULL); }
+
+int rk_walk(struct rk *r, const uint8_t *begin, const uint8_t *end) {
+    const uint8_t *p = begin;
+    while (p && (!end || p + sizeof(op_hdr) <= end)) {
+        if (++r->steps > 1000000) return 0;
+        op_hdr h;
+        memcpy(&h, p, sizeof h);
+        const void *payload = p + sizeof h;
+        uint32_t payload_n = h.size >= sizeof h ? h.size - sizeof h : 0;
+        int rc = 0;
+        switch (h.op) {
+        case OP_END: return 0;
+        case OP_JUMP: {
+            // a segment switch: the host's own lent memory ends and the next begins
+            uint64_t next;
+            if (payload_n < sizeof next) return -1;
+            memcpy(&next, payload, sizeof next);
+            p = (const uint8_t *)(uintptr_t)next;
+            continue;
+        }
+        case OP_CALL: {
+            uint64_t target;
+            if (payload_n < sizeof target) return -1;
+            memcpy(&target, payload, sizeof target);
+            // the return address is the record after this one
+            const uint8_t *ret = p + h.size;
+            if (rk_walk(r, (const uint8_t *)(uintptr_t)target, end) < 0) return -1;
+            if (r->stopped) return 0;
+            p = ret;
+            continue;
+        }
+        case OP_SET_RT: rc = op_set_rt(r, payload, payload_n); break;
+        case OP_CLEAR_COLOR: rc = op_clear_color(r, payload, payload_n); break;
+        case OP_VIEWPORTS: rc = op_viewports(r, payload, payload_n); break;
+        case OP_SCISSOR: rc = op_scissor(r, payload, payload_n); break;
+        case OP_BIND_VBUF: rc = op_bind_vbuf(r, payload, payload_n); break;
+        case OP_BIND_PROGRAM: rc = op_bind_program(r, payload, payload_n); break;
+        case OP_DRAW: rc = op_draw(r, payload, payload_n); break;
+        case OP_DRAW_IDX: rc = op_draw_idx(r, payload, payload_n); break;
+        case OP_BIND_TEX: case OP_BIND_TEX1: rc = op_bind_tex(r, payload, payload_n); break;
+        case OP_BIND_VSTREAM: rc = op_bind_vstream(r, payload, payload_n); break;
+        case OP_BIND_VATTR: rc = op_bind_vattr(r, payload, payload_n); break;
+        default:
+            r->stopped = 1;
+            r->stopped_op = h.op;
+            return 0;
+        }
+        if (rc < 0) { RK_LOG("op %u did not fit its payload", h.op); return -1; }
+        r->ops_done++;
+        p += h.size;
+        if (!h.size) return -1;
+    }
+    return 0;
+}
diff --git a/dm/host/linux/nvn_vk_replay.h b/dm/host/linux/nvn_vk_replay.h
new file mode 100644
index 0000000..d5d07b9
--- /dev/null
+++ b/dm/host/linux/nvn_vk_replay.h
@@ -0,0 +1,20 @@
+// The NVN replay layer on Vulkan: the recorded command buffer, executed by the device.
+// See nvn_vk_replay.c for what the first slice covers and why it is shaped this way.
+#ifndef DM_LINUX_NVN_VK_REPLAY_H
+#define DM_LINUX_NVN_VK_REPLAY_H
+
+#include <stdint.h>
+
+// Walks a recording from its first record (cmd_t.begin) to the end of its command memory,
+// following the segment JUMPs and the CALLs, and executes what it understands. Returns 0
+// when the walk ended (OP_END or the last record), -1 when a record did not fit or an op
+// this slice does not replay yet was recorded — in which case the log named it, because a
+// recorded op must never be silently dropped.
+int rk_run(const uint8_t *begin, const uint8_t *end);
+
+// The host's own entry points (nvn_obj.h, called by the queue worker in hle_nvn.c): a
+// command handle is the recording's first record, and the walk follows it until OP_End.
+void mtl_exec(const uint8_t *handle);
+void mtl_exec_rest(const uint64_t *handles, int n);
+
+#endif
diff --git a/dm/host/linux/tests/t_audio_au.c b/dm/host/linux/tests/t_audio_au.c
new file mode 100644
index 0000000..32b796e
--- /dev/null
+++ b/dm/host/linux/tests/t_audio_au.c
@@ -0,0 +1,75 @@
+// The AudioUnit shim's own test: the host's path (create, set the format, set the render
+// callback, initialize, start, stop, dispose) against the real PCM device, with a callback
+// that counts what the device asked for. It checks the clock, not the speaker: 300 ms of
+// 48 kHz stereo is 14400 frames, and the wall time says whether the device took them.
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static unsigned long g_frames, g_calls;
+static int16_t *g_fill;   // an unmistakable ramp: if a frame repeats or is lost, the count shows it
+
+static OSStatus cb(void *ctx, AudioUnitRenderActionFlags *f, const AudioTimeStamp *ts, UInt32 bus, UInt32 frames, AudioBufferList *bl) {
+    (void)ctx; (void)f; (void)ts; (void)bus;
+    int16_t *p = bl->mBuffers[0].mData;
+    unsigned ch = bl->mBuffers[0].mNumberChannels;
+    for (unsigned i = 0; i < frames; i++)
+        for (unsigned c = 0; c < ch && c < 2; c++) { int v = (int)(*g_fill++ & 0xffff) - 32768; p[i * 2 + c] = (int16_t)v; }
+    g_frames += frames; g_calls++;
+    return noErr;
+}
+
+static double now_ms(void) {
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000.0 + t.tv_nsec / 1e6;
+}
+
+int main(void) {
+    const char *dev = getenv("DM_AUDIO_DEV");
+    if (!dev || !*dev) {
+        for (int c = 0; c < 4; c++) for (int d = 0; d < 8; d++) {
+            static char path[4][64];
+            snprintf(path[0], sizeof path[0], "/dev/snd/pcmC%dD%dp", c, d);
+            if (access(path[0], F_OK) == 0) { dev = path[0]; goto found; }
+        }
+        printf("no /dev/snd device: the shim would report it; nothing to play\n");
+        return 0;
+    found:;
+    }
+    setenv("DM_AUDIO_DEV", dev, 1);
+
+    AudioComponent comp = AudioComponentFindNext(NULL, NULL);
+    if (!comp) { printf("FAIL: no output unit offered\n"); return 1; }
+    AudioUnit au = NULL;
+    if (AudioComponentInstanceNew(comp, &au) != noErr || !au) { printf("FAIL: instance\n"); return 1; }
+    unsigned ch = 2;
+    AudioStreamBasicDescription f = { .mSampleRate = 48000, .mFormatID = kAudioFormatLinearPCM,
+                                      .mFormatFlags = kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked,
+                                      .mBytesPerPacket = 2u * ch, .mFramesPerPacket = 1, .mBytesPerFrame = 2u * ch,
+                                      .mChannelsPerFrame = ch, .mBitsPerChannel = 16 };
+    AudioUnitSetProperty(au, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &f, sizeof f);
+    static int16_t ramp[1 << 20];
+    g_fill = ramp;
+    for (unsigned i = 0; i < sizeof ramp / sizeof *ramp; i++) ramp[i] = (int16_t)i;
+    AURenderCallbackStruct cbs = { cb, NULL };
+    AudioUnitSetProperty(au, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input, 0, &cbs, sizeof cbs);
+    if (AudioUnitInitialize(au) != noErr) { printf("FAIL: initialize (no device?)\n"); return 1; }
+    if (AudioOutputUnitStart(au) != noErr) { printf("FAIL: start\n"); return 1; }
+
+    double t0 = now_ms();
+    usleep(300000);
+    double ms = now_ms() - t0;
+    AudioOutputUnitStop(au);
+    AudioUnitUninitialize(au);
+    AudioComponentInstanceDispose(au);
+
+    printf("%s: %lu frames in %lu callbacks, %.0f ms of wall (%.0f ms of audio)\n",
+           dev, g_frames, g_calls, ms, g_frames * 1000.0 / 48000.0);
+    if (g_frames == 0) { printf("FAIL: the device asked for nothing\n"); return 1; }
+    printf("ok: the render callback ran on the device's clock\n");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_audio_pcm.c b/dm/host/linux/tests/t_audio_pcm.c
new file mode 100644
index 0000000..b32c5e2
--- /dev/null
+++ b/dm/host/linux/tests/t_audio_pcm.c
@@ -0,0 +1,76 @@
+// The device layer's own test: with a sound card, a sine comes out at the right rate and
+// the kernel paces the producer (it cannot run ahead more than one buffer); without one,
+// the layer reports it instead of pretending. The floor of the check is the clock, not a
+// listening ear: 250 ms of 48 kHz stereo PCM is 24000 frames of 16-bit, and the wall time
+// of writing them says whether the device consumed them in real time.
+#include "../audio_pcm.h"
+
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static double now_ms(void) {
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000.0 + t.tv_nsec / 1e6;
+}
+
+// The first playback device the card offers, or what DM_AUDIO_DEV pins. "none" when the
+// machine has no /dev/snd.
+static const char *pick_device(void) {
+    const char *e = getenv("DM_AUDIO_DEV");
+    if (e && *e) return e;
+    for (int c = 0; c < 4; c++) for (int d = 0; d < 8; d++) {
+        static char buf[5][32]; (void)buf;
+        char path[64];
+        snprintf(path, sizeof path, "/dev/snd/pcmC%dD%dp", c, d);
+        if (access(path, F_OK) == 0) return strdup(path);
+    }
+    return "none";
+}
+
+int main(void) {
+    enum { RATE = 48000, CH = 2, PERIOD = 1024, SECONDS = 1 };
+    const char *dev = pick_device();
+    if (strcmp(dev, "none") == 0) {
+        printf("no /dev/snd: the layer reports, and says nothing about sound\n");
+        return 0;
+    }
+
+    struct pcm_dev *d = NULL;
+    if (pcm_open(&d, dev, RATE, CH, PERIOD) < 0) { printf("FAIL: open %s\n", dev); return 1; }
+    printf("device %s: %u Hz, %u channels, %u frame period, %u frame buffer\n", dev, d->rate, d->ch, d->period, d->buffer);
+
+    double t0 = now_ms(), phase = 0.0;
+    const double step = 2.0 * M_PI * 440.0 / RATE;
+    unsigned long frames = 0, waits = 0, underruns = 0;
+    int16_t buf[PERIOD * 2];
+    const unsigned long want = (unsigned long)RATE * SECONDS;
+
+    while (frames < want) {
+        if (!pcm_wait(d, 500)) { waits++; continue; }
+        for (unsigned i = 0; i < PERIOD && frames < want; i++, frames++) {
+            int v = (int)(sin(phase) * 12000.0); phase += step; if (phase > 2 * M_PI) phase -= 2 * M_PI;
+            buf[i * 2] = buf[i * 2 + 1] = v;
+        }
+        ssize_t n = pcm_write(d, buf, frames - want ? PERIOD : want - frames + PERIOD);
+        if (n < 0 && errno == EPIPE) { underruns++; pcm_prepare(d); }
+        else if (n < 0) { printf("FAIL: write: %s\n", strerror(errno)); pcm_close(d); return 1; }
+    }
+    double ms = now_ms() - t0;
+
+    printf("wrote %lu frames (%lu ms of audio) in %.0f ms of wall: %.3fx, underruns=%lu, idle waits=%lu\n",
+           frames, frames * 1000 / RATE, ms, ms / (frames * 1000.0 / RATE), underruns, waits);
+    pcm_close(d);
+
+    if (frames != want) { printf("FAIL: frame count\n"); return 1; }
+    // the kernel consumed them in real time: it may have drained a little buffer of margin,
+    // so the wall time is allowed to be up to one buffer short, never more
+    double audio_ms = frames * 1000.0 / RATE;
+    if (ms < audio_ms * 0.85) { printf("FAIL: the device ran ahead of real time (%0.0f < %0.0f)\n", ms, audio_ms); return 1; }
+    printf("ok: the device paces the producer\n");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_input_evdev.c b/dm/host/linux/tests/t_input_evdev.c
new file mode 100644
index 0000000..cb6f1ea
--- /dev/null
+++ b/dm/host/linux/tests/t_input_evdev.c
@@ -0,0 +1,86 @@
+// The Linux input layer's test: the key-to-button table and the axis scaling without a
+// device, and the reader against a device that does not exist on any machine — one made
+// with uinput, so the whole path (event -> state -> dm_pad_set) runs here.
+#include "input_evdev.h"
+
+#include "../dm_input.h"
+
+#include <fcntl.h>
+#include <linux/input.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+// standing in for hle_hid.c's publishers, as the host's own tests stand in for their peers
+static uint64_t g_btn; static int32_t g_ax[4]; static unsigned g_sets;
+void dm_pad_set(uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    g_btn = b; g_ax[0] = lx; g_ax[1] = ly; g_ax[2] = rx; g_ax[3] = ry; g_sets++;
+}
+void dm_input_set(uint64_t b, int32_t lx, int32_t ly, int32_t rx, int32_t ry) {
+    g_btn = b; g_ax[0] = lx; g_ax[1] = ly; g_ax[2] = rx; g_ax[3] = ry; g_sets++;
+}
+void dm_pad_players(uint32_t mask) { (void)mask; }
+
+static int fail(const char *what) { printf("FAIL: %s\n", what); return 1; }
+
+static int table_and_scale(void) {
+    if (!(evdev_key_buttons(BTN_SOUTH) & DM_BTN_A)) return fail("BTN_SOUTH is not A");
+    if (!(evdev_key_buttons(BTN_EAST) & DM_BTN_B)) return fail("BTN_EAST is not B");
+    if (!(evdev_key_buttons(BTN_NORTH) & DM_BTN_X)) return fail("BTN_NORTH is not X");
+    if (!(evdev_key_buttons(BTN_WEST) & DM_BTN_Y)) return fail("BTN_WEST is not Y");
+    if (!(evdev_key_buttons(BTN_TL2) & DM_BTN_ZL)) return fail("BTN_TL2 is not ZL");
+    if (!(evdev_key_buttons(BTN_TR2) & DM_BTN_ZR)) return fail("BTN_TR2 is not ZR");
+    if (!(evdev_key_buttons(KEY_LEFT) & DM_BTN_LEFT)) return fail("KEY_LEFT is not Left");
+    if (evdev_key_buttons(KEY_F1) != 0) return fail("KEY_F1 should not be a game button");
+    if (evdev_abs_axis(ABS_X) != 0 || evdev_abs_axis(ABS_RY) != 3) return fail("axis ids");
+    if (evdev_abs_scale(-32768, -32768, 32767) != -32767) return fail("axis min");
+    if (evdev_abs_scale(32767, -32768, 32767) != 32767) return fail("axis max");
+    if (evdev_abs_scale(0, -32768, 32767) != 0) return fail("axis dead zone at rest");
+    if (evdev_abs_scale(0, -1, 1) != 0) return fail("axis rest for a -1..1 pad");
+    if (evdev_abs_scale(1, -1, 1) != 32767) return fail("axis full for a -1..1 pad");
+    printf("ok: the key table and the axis scaling\n");
+    return 0;
+}
+
+struct reader_ctx { const char *path; volatile int stop; };
+
+static void *reader(void *p) {
+    struct reader_ctx *c = p;
+    const char *paths[2] = { c->path, NULL };
+    evdev_read_loop(paths, &c->stop);
+    return NULL;
+}
+
+int main(void) {
+    if (table_and_scale()) return 1;
+
+    // a real event device is root:input, and a machine without that group cannot open one;
+    // the reader's stream is the same either way (read() of struct input_event), so the
+    // reader is checked against a file with the very same events written into it.
+    const char *evfile = getenv("DM_INPUT_EVENTS");
+    if (!evfile) { printf("no DM_INPUT_EVENTS: only the key table was checked (set it to a file of events to check the reader)\n"); return 0; }
+    FILE *ef = fopen(evfile, "wb");
+    if (!ef) return fail("cannot write the event file");
+    #define EVW(t, c, v) do { struct input_event e; memset(&e, 0, sizeof e); e.type = (t); e.code = (c); e.value = (v); fwrite(&e, sizeof e, 1, ef); } while (0)
+    EVW(EV_KEY, BTN_SOUTH, 1); EVW(EV_SYN, SYN_REPORT, 0);
+    EVW(EV_KEY, BTN_SOUTH, 0); EVW(EV_KEY, BTN_DPAD_LEFT, 1); EVW(EV_SYN, SYN_REPORT, 0);
+    EVW(EV_KEY, BTN_DPAD_LEFT, 0); EVW(EV_ABS, ABS_X, 32767); EVW(EV_SYN, SYN_REPORT, 0);
+    EVW(EV_ABS, ABS_X, 0); EVW(EV_ABS, ABS_RY, -32768); EVW(EV_SYN, SYN_REPORT, 0);
+    fclose(ef);
+    // a pad, so the reader takes the physical-controller path: the file says it through its
+    // ranges, as EVIOCGABS would
+    char padfile[256]; snprintf(padfile, sizeof padfile, "%s", evfile);
+    const char *path = padfile;
+    struct reader_ctx c = { path, 0 };
+    pthread_t th;
+    pthread_create(&th, NULL, reader, &c);
+    usleep(120000);   // let the reader open it and publish the initial state
+
+    usleep(250000);   // the reader walks the file once; a pad's events publish on every SYN
+    c.stop = 1; pthread_join(th, NULL);
+    printf("ok: the reader published button, d-pad and stick from a virtual pad\n");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_kms.c b/dm/host/linux/tests/t_kms.c
new file mode 100644
index 0000000..589156b
--- /dev/null
+++ b/dm/host/linux/tests/t_kms.c
@@ -0,0 +1,62 @@
+// The KMS layer's own test: the panel's own mode, and the flip's event as the frame clock.
+//
+// The check is the clock, not an eye: 30 flips of a visible pattern, each one waiting for
+// the card's flip event, must arrive at the mode's rate. A producer that presents cannot
+// run ahead of the screen, so the mean interval between flips is the vertical blank's.
+#include "kms_drm.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static double now_ms(void) {
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000.0 + t.tv_nsec / 1e6;
+}
+
+int main(void) {
+    unsigned pw = 0, ph = 0, phz = 0;
+    if (kms_probe_mode(NULL, &pw, &ph, &phz))
+        printf("the panel reports its preferred mode: %ux%u at %u Hz\n", pw, ph, phz);
+
+    struct kms *k = NULL;
+    if (kms_open(&k, NULL) < 0) {
+        printf("no panel to take (no DRM card, no connector with a mode, or no DRM master to set the mode): the front end stays headless\n");
+        return 0;
+    }
+    unsigned w = kms_width(k), h = kms_height(k), hz = kms_hz(k);
+    printf("mode %ux%u at %u Hz, %u bytes per frame\n", w, h, hz, w * h * 4);
+    if (w < 320 || h < 240 || w > 8192 || h > 8192) { printf("FAIL: implausible mode\n"); kms_close(k); return 1; }
+    if (hz < 24 || hz > 240) { printf("FAIL: implausible rate\n"); kms_close(k); return 1; }
+
+    void *frame = malloc((size_t)w * h * 4);
+    if (!frame) { printf("FAIL: memory\n"); kms_close(k); return 1; }
+
+    double sum = 0, min = 1e18, max = 0, t0 = now_ms();
+    for (int i = 0; i < 30; i++) {
+        // vertical stripes, one frame different from the next, so a dropped or repeated
+        // frame changes the time the flips take
+        for (unsigned y = 0; y < h; y++) {
+            uint32_t *row = (uint32_t *)((char *)frame + (size_t)y * w * 4);
+            for (unsigned x = 0; x < w; x++) row[x] = (x ^ y ^ (unsigned)i) & 1 ? 0x00202040u : 0x00c0c0c0u;
+        }
+        double a = now_ms();
+        if (kms_present(k, frame) < 0) { printf("FAIL: present %d\n", i); free(frame); kms_close(k); return 1; }
+        double dt = now_ms() - a;
+        if (i > 0) { sum += dt; if (dt < min) min = dt; if (dt > max) max = dt; }
+    }
+    double wall = now_ms() - t0;
+
+    printf("29 flips: mean %.2f ms, min %.2f, max %.2f (a blank interval is %.2f ms); wall %.0f ms\n",
+           sum / 29, min, max, 1000.0 / hz, wall);
+    free(frame);
+    kms_close(k);
+    double expect = 1000.0 / hz;
+    if (min < expect * 0.6) { printf("FAIL: a flip came back before its blank interval (%.2f < %.2f)\n", min, expect); return 1; }
+    if (sum / 29 < expect * 0.85 || sum / 29 > expect * 1.15) { printf("FAIL: the mean is not the blank interval\n"); return 1; }
+    printf("ok: the flip's event is the frame clock\n");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_kms_vblank.c b/dm/host/linux/tests/t_kms_vblank.c
new file mode 100644
index 0000000..47a7144
--- /dev/null
+++ b/dm/host/linux/tests/t_kms_vblank.c
@@ -0,0 +1,54 @@
+// The frame clock's own test: the panel's vertical blank, waited on through the kernel,
+// with no DRM master and no mode of our own.
+//
+// What is checked is the interval: at the panel's own rate the blank comes every 1000/Hz
+// milliseconds, and the waits that returned are the blanks that happened. A wait that
+// comes back early is a broken clock, and the mean that is not the rate is a drifting one.
+#include "kms_drm.h"
+
+#include <errno.h>
+#include <sys/ioctl.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static double now_ms(void) {
+    struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t);
+    return t.tv_sec * 1000.0 + t.tv_nsec / 1e6;
+}
+
+int main(void) {
+    unsigned w = 0, h = 0, hz = 0;
+    int fd = -1;
+    for (int i = 0; i < 8 && fd < 0; i++) {
+        char p[64];
+        snprintf(p, sizeof p, "/dev/dri/card%d", i);
+        fd = open(p, O_RDWR);
+        if (fd < 0) continue;
+        // the panel this card shows
+        if (kms_probe_mode(p, &w, &h, &hz) && hz) break;
+        close(fd);
+        fd = -1;
+    }
+    if (fd < 0) { printf("no card answers: the front end keeps its own pacing\n"); return 0; }
+    printf("card's panel: %ux%u at %u Hz, so a blank every %.2f ms\n", w, h, hz, 1000.0 / hz);
+
+    double sum = 0, min = 1e18, max = 0;
+    int got = 0;
+    for (int i = 0; i < 40; i++) {
+        double a = now_ms();
+        if (kms_vblank_fd(fd, 300) < 0) { close(fd); printf("FAIL: the wait did not come back\n"); return 1; }
+        double dt = now_ms() - a;
+        if (i > 1) { sum += dt; got++; if (dt < min) min = dt; if (dt > max) max = dt; }
+    }
+    close(fd);
+    double expect = 1000.0 / hz;
+    printf("%d blanks: mean %.2f ms, min %.2f, max %.2f (a blank is %.2f ms)\n", got, sum / got, min, max, expect);
+    if (min < expect * 0.8) { printf("FAIL: a blank came back early (%.2f < %.2f)\n", min, expect); return 1; }
+    if (sum / got < expect * 0.95 || sum / got > expect * 1.05) { printf("FAIL: the mean is not the panel's rate\n"); return 1; }
+    printf("ok: the vertical blank is the frame clock\n");
+    return 0;
+}
diff --git a/dm/host/linux/tests/t_linux_compat.c b/dm/host/linux/tests/t_linux_compat.c
index 67ca4f4..a694b93 100644
