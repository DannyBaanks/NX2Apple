diff --git a/dm/host/linux/audio_au.c b/dm/host/linux/audio_au.c
new file mode 100644
index 0000000..4a2b21a
--- /dev/null
+++ b/dm/host/linux/audio_au.c
@@ -0,0 +1,222 @@
+// The AudioUnit the host's audio layer creates, on the Linux device layer (audio_pcm.c).
+//
+// Apple's model is a pull: the output unit calls its render callback whenever the device
+// needs frames, and the host fills the buffer from its queues (pull_device). A PCM device
+// is a push: the host thread writes and the kernel paces it. So the callback becomes the
+// inner step of that thread's loop — the same code runs, on the thread that waits for the
+// device instead of one the device wakes. The mixer, the volume, the underruns and the
+// counters are the host's and are not touched here.
+#include "audio_pcm.h"
+#include <AudioToolbox/AudioToolbox.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#define AU_LOG(...) do { fprintf(stderr, "[dm] [linux] [au] " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+// The device frames the host asks the unit's property for. About 5 ms, the value the Mac
+// path requests for the same reason (its own default of 512 frames can outrun the game's
+// queued PCM), and what DMA_AUDIO_FR... (see hle_audio.c) overrides there.
+enum { AU_DEVICE_FRAMES = 1024 };
+
+struct au_dev {
+    struct pcm_dev *pcm;
+    int pipe_fd;
+    unsigned rate;
+    AURenderCallbackStruct cb;
+    AudioStreamBasicDescription fmt;
+    pthread_t th;
+    volatile int run;
+    unsigned ch, period;
+};
+
+static const AudioComponent g_one_component = (AudioComponent)&g_one_component;   // the shim offers exactly one output
+
+static const char *pick_device(void) {
+    const char *e = getenv("DM_AUDIO_DEV");
+    if (e && *e) return e;
+    static char path[64];
+    for (int c = 0; c < 4; c++) for (int d = 0; d < 8; d++) {
+        snprintf(path, sizeof path, "/dev/snd/pcmC%dD%dp", c, d);
+        if (access(path, F_OK) == 0) return path;   // the first playback device the card offers
+    }
+    return "none";
+}
+
+AudioComponent AudioComponentFindNext(AudioComponent c, const AudioComponentDescription *d) {
+    (void)d;
+    return c == NULL ? g_one_component : NULL;   // one output, as on iOS ("1 on the host")
+}
+
+static void *au_render_thread(void *p) {
+    struct au_dev *a = p;
+    unsigned frames = a->period, bytes = frames * a->fmt.mBytesPerFrame;
+    AudioBufferList bl = { .mNumberBuffers = 1 };
+    bl.mBuffers[0].mData = malloc(bytes);
+    bl.mBuffers[0].mDataByteSize = bytes;
+    bl.mBuffers[0].mNumberChannels = a->ch;
+    struct timespec next_ts;
+    clock_gettime(CLOCK_MONOTONIC, &next_ts);
+    uint64_t period_ns = a->rate ? ((uint64_t)frames * 1000000000ull / a->rate) : 21333333ull;
+    while (a->run) {
+        if (a->pipe_fd >= 0) {
+            next_ts.tv_nsec += (long)period_ns;
+            while (next_ts.tv_nsec >= 1000000000L) { next_ts.tv_nsec -= 1000000000L; next_ts.tv_sec += 1; }
+            clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &next_ts, NULL);
+            if (!a->run) break;
+            if (a->cb.inputProc(a->cb.inputProcRefCtx, NULL, NULL, 0, frames, &bl)) continue;
+            const uint8_t *src = (const uint8_t *)bl.mBuffers[0].mData;
+            size_t off = 0;
+            while (off < bytes && a->run) {
+                struct pollfd pfd = { .fd = a->pipe_fd, .events = POLLOUT };
+                int pr = poll(&pfd, 1, 50);
+                if (pr == 0) break;   // reader stalled: drop this period rather than deadlocking stop
+                if (pr < 0) {
+                    if (errno == EINTR) continue;
+                    break;
+                }
+                if (pfd.revents & (POLLERR | POLLHUP)) { a->run = 0; break; }
+                ssize_t n = write(a->pipe_fd, src + off, bytes - off);
+                if (n < 0) {
+                    if (errno == EINTR) continue;
+                    if (errno == EAGAIN || errno == EWOULDBLOCK) break;
+                    if (errno == EPIPE) { a->run = 0; break; }
+                    AU_LOG("pipe write: %s", strerror(errno));
+                    break;
+                }
+                off += (size_t)n;
+            }
+            continue;
+        }
+        if (!pcm_wait(a->pcm, 100)) continue;
+        if (a->cb.inputProc(a->cb.inputProcRefCtx, NULL, NULL, 0, frames, &bl)) continue;
+        ssize_t n = pcm_write(a->pcm, bl.mBuffers[0].mData, frames);
+        if (n < 0 && errno == EPIPE) pcm_prepare(a->pcm);   // underrun: re-arm, the host counts it
+        else if (n < 0) AU_LOG("write: %s", strerror(errno));
+    }
+    free(bl.mBuffers[0].mData);
+    return NULL;
+}
+
+OSStatus AudioComponentInstanceNew(AudioComponent c, AudioUnit *out) {
+    (void)c;
+    struct au_dev *a = calloc(1, sizeof *a);
+    if (!a) { *out = NULL; return -1; }
+    a->pipe_fd = -1;
+    *out = a;
+    return noErr;
+}
+
+OSStatus AudioUnitSetProperty(AudioUnit au, AudioUnitPropertyID id, AudioUnitScope scope, AudioUnitElement el, const void *v, UInt32 size) {
+    (void)scope; (void)el;
+    struct au_dev *a = au;
+    if (id == kAudioUnitProperty_SetRenderCallback && size == sizeof(AURenderCallbackStruct)) a->cb = *(const AURenderCallbackStruct *)v;
+    else if (id == kAudioUnitProperty_StreamFormat && size == sizeof(AudioStreamBasicDescription)) a->fmt = *(const AudioStreamBasicDescription *)v;
+    return noErr;
+}
+
+OSStatus AudioUnitInitialize(AudioUnit au) {
+    struct au_dev *a = au;
+    unsigned ch = a->fmt.mChannelsPerFrame ? a->fmt.mChannelsPerFrame : 2;
+    unsigned rate = a->fmt.mSampleRate > 0 ? (unsigned)a->fmt.mSampleRate : 48000;
+    unsigned period = AU_DEVICE_FRAMES;
+    const char *frames_env = getenv("DM_DBG_AU_FRAMES");   // the Mac path's override, same meaning
+    if (frames_env && *frames_env) { unsigned f = (unsigned)atoi(frames_env); if (f >= 64 && f <= 8192) period = f; }
+    const char *pipe_path = getenv("DM_AUDIO_PIPE");
+    if (pipe_path && *pipe_path) {
+        signal(SIGPIPE, SIG_IGN);
+        int fd = open(pipe_path, O_WRONLY | O_CREAT | O_NONBLOCK | O_CLOEXEC, 0644);
+        if (fd < 0) { AU_LOG("cannot open DM_AUDIO_PIPE %s: %s", pipe_path, strerror(errno)); return -1; }
+        a->pipe_fd = fd;
+        a->rate = rate;
+        a->ch = ch;
+        a->period = period;
+        a->run = 1;
+        AU_LOG("streaming PCM (%u Hz %uch) to %s", rate, ch, pipe_path);
+        if (pthread_create(&a->th, NULL, au_render_thread, a)) { a->run = 0; close(a->pipe_fd); a->pipe_fd = -1; return -1; }
+        return noErr;
+    }
+    const char *dev = pick_device();
+    if (strcmp(dev, "none") == 0) { AU_LOG("no /dev/snd device: no output"); return -1; }
+    if (pcm_open(&a->pcm, dev, rate, ch, period) < 0) return -1;   // pcm_open logged the reason
+    a->rate = rate; a->ch = ch; a->period = a->pcm->period; a->run = 1;
+    if (pthread_create(&a->th, NULL, au_render_thread, a)) { a->run = 0; pcm_close(a->pcm); a->pcm = NULL; return -1; }
+    return noErr;
+}
+
+OSStatus AudioOutputUnitStart(AudioUnit au) {
+    struct au_dev *a = au;
+    if ((a->pcm || a->pipe_fd >= 0) && !a->run) {   // stopped earlier: the device waits again
+        a->run = 1;
+        if (pthread_create(&a->th, NULL, au_render_thread, a)) { a->run = 0; return -1; }
+    }
+    return noErr;
+}
+
+OSStatus AudioOutputUnitStop(AudioUnit au) {
+    struct au_dev *a = au;
+    if ((a->pcm || a->pipe_fd >= 0) && a->run) {
+        a->run = 0;
+        pthread_join(a->th, NULL);
+    }
+    return noErr;
+}
+
+OSStatus AudioUnitUninitialize(AudioUnit au) {
+    AudioOutputUnitStop(au);
+    struct au_dev *a = au;
+    if (a->pcm) { pcm_close(a->pcm); a->pcm = NULL; }
+    if (a->pipe_fd >= 0) { close(a->pipe_fd); a->pipe_fd = -1; }
+    return noErr;
+}
+
+OSStatus AudioComponentInstanceDispose(AudioUnit au) {
+    if (!au) return noErr;
+    AudioUnitUninitialize(au);
+    free(au);
+    return noErr;
+}
+
+OSStatus AudioUnitGetProperty(AudioUnit au, AudioUnitPropertyID id, AudioUnitScope scope, AudioUnitElement el, void *v, UInt32 *size) {
+    (void)scope; (void)el;
+    struct au_dev *a = au;
+    if (id == kAudioOutputUnitProperty_CurrentDevice) {
+        if (*size < sizeof(AudioDeviceID)) return -1;
+        *(AudioDeviceID *)v = kAudioObjectUnknown;   // no device change is published on Linux
+        return noErr;
+    }
+    if (id == kAudioDevicePropertyBufferFrameSize) {
+        if (*size < sizeof(UInt32)) return -1;
+        *(UInt32 *)v = a->pcm ? a->pcm->period : AU_DEVICE_FRAMES;
+        return noErr;
+    }
+    if (id == kAudioDevicePropertyBufferFrameSizeRange) {
+        if (*size < sizeof(AudioValueRange)) return -1;
+        AudioValueRange *r = v; r->mMinimum = 64; r->mMaximum = 8192;
+        return noErr;
+    }
+    if (id == kAudioUnitProperty_StreamFormat) {
+        if (*size < sizeof(AudioStreamBasicDescription)) return -1;
+        *(AudioStreamBasicDescription *)v = a->fmt;
+        return noErr;
+    }
+    return -1;
+}
+
+OSStatus AudioUnitAddPropertyListener(AudioUnit au, AudioUnitPropertyID id, void (*fn)(void *, AudioUnit, AudioUnitPropertyID, AudioUnitScope, AudioUnitElement), void *ctx) {
+    (void)au; (void)id; (void)fn; (void)ctx;
+    return noErr;   // a PCM device does not come and go under a running host
+}
+
+OSStatus AudioUnitRemovePropertyListenerWithUserData(AudioUnit au, AudioUnitPropertyID id, void (*fn)(void *, AudioUnit, AudioUnitPropertyID, AudioUnitScope, AudioUnitElement), void *ctx) {
+    (void)au; (void)id; (void)fn; (void)ctx;
+    return noErr;
+}
diff --git a/dm/host/linux/audio_pcm.c b/dm/host/linux/audio_pcm.c
new file mode 100644
index 0000000..937a84f
--- /dev/null
+++ b/dm/host/linux/audio_pcm.c
@@ -0,0 +1,160 @@
+// The Linux audio device layer: the PCM device straight through the kernel interface, with
+// no alsa-lib. The host stays a static ELF with no library of its own, the way the Mach
+// stand-ins read /proc/self/mem instead of libkern.
+//
+// The protocol is the one the kernel answers, measured on this machine (Linux 7.0):
+//   open O_RDWR|O_NONBLOCK, INFO / PVERSION / TTSTAMP, then HW_REFINE once per parameter and
+//   fix it (a single refine with every bit leaves the derived parameters inconsistent), and
+//   HW_PARAMS with rmask 0, SW_PARAMS with the defaults below, PREPARE. Then the producer
+//   waits for POLLOUT and writes complete blocks.
+//
+// Two things the measurement decided:
+//   * the period and buffer times are fixed as NON-integer open ranges (integer=1 makes the
+//     kernel refuse the whole area with EINVAL);
+//   * the derived parameters (sample and frame bits, period and buffer bytes, the period
+//     count) are fixed at the values the format implies, because the kernel does not derive
+//     them for an area built here.
+//
+// Everything reports instead of pretending: no device, a device that refuses the format, an
+// underrun mid-stream. The caller's fallback (the silent sink) is its own, as it is on Apple.
+#include "audio_pcm.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sound/asound.h>
+
+#define PCM_LOG(...) do { fprintf(stderr, "[dm] [linux] [pcm] " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+static void mask_only(struct snd_mask *m, unsigned v) {
+    memset(m->bits, 0, sizeof m->bits);
+    m->bits[(v >> 5) & 7] = 1u << (v & 31);
+}
+static void mask_any(struct snd_mask *m) { memset(m->bits, 0xff, sizeof m->bits); }
+static void interval_any(struct snd_interval *i) {
+    i->min = 0; i->max = 0xffffffffu; i->openmin = i->openmax = 0; i->integer = 1; i->empty = 0;
+}
+static void interval_exact(struct snd_interval *i, unsigned v) {
+    i->min = i->max = v; i->openmin = i->openmax = 0; i->integer = 1; i->empty = 0;
+}
+static void interval_open_us(struct snd_interval *i, unsigned lo, unsigned hi) {
+    i->min = lo; i->max = hi; i->openmin = i->openmax = 1; i->integer = 0; i->empty = 0;
+}
+
+#define MI(fd, p, what) (ioctl((fd), SNDRV_PCM_IOCTL_HW_REFINE, (p)) < 0 ? what : 0)
+
+int pcm_open(struct pcm_dev **out, const char *dev, unsigned rate, unsigned ch, unsigned period_frames) {
+    *out = NULL;
+    int fd = open(dev, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) { PCM_LOG("%s: %s", dev, strerror(errno)); return -1; }
+
+    struct snd_pcm_info info;
+    memset(&info, 0, sizeof info);
+    ioctl(fd, SNDRV_PCM_IOCTL_INFO, &info);
+    int ver = 0, tstamp = 1;
+    ioctl(fd, SNDRV_PCM_IOCTL_PVERSION, &ver);
+    ioctl(fd, SNDRV_PCM_IOCTL_TTSTAMP, &tstamp);
+
+    unsigned buffer_frames = period_frames * 4;
+    struct snd_pcm_hw_params p;
+    int e;
+
+    memset(&p, 0, sizeof p);
+    for (int i = SNDRV_PCM_HW_PARAM_FIRST_MASK; i <= SNDRV_PCM_HW_PARAM_LAST_MASK; i++) mask_any(&p.masks[i - SNDRV_PCM_HW_PARAM_FIRST_MASK]);
+    for (int i = SNDRV_PCM_HW_PARAM_FIRST_INTERVAL; i <= SNDRV_PCM_HW_PARAM_LAST_INTERVAL; i++) interval_any(&p.intervals[i - SNDRV_PCM_HW_PARAM_FIRST_INTERVAL]);
+    p.rmask = 0;
+    if (ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, &p) < 0) { PCM_LOG("%s: hw_refine(any): %s", dev, strerror(errno)); close(fd); return -1; }
+
+    for (unsigned v = SNDRV_PCM_HW_PARAM_FIRST_MASK; v <= SNDRV_PCM_HW_PARAM_LAST_MASK; v++) {
+        p.rmask = 1u << v;
+        if ((e = ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, &p)) < 0) { PCM_LOG("%s: hw_refine(mask %u): %s", dev, v, strerror(errno)); close(fd); return -1; }
+        mask_any(&p.masks[v - SNDRV_PCM_HW_PARAM_FIRST_MASK]);
+    }
+#define FIX_MASK(param, val) do { \
+        p.rmask = 1u << (param); \
+        if (ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, &p) < 0) { PCM_LOG("%s: hw_refine(%s): %s", dev, #param, strerror(errno)); close(fd); return -1; } \
+        mask_only(&p.masks[(param) - SNDRV_PCM_HW_PARAM_FIRST_MASK], (val)); \
+    } while (0)
+    FIX_MASK(SNDRV_PCM_HW_PARAM_ACCESS, SNDRV_PCM_ACCESS_RW_INTERLEAVED);
+    FIX_MASK(SNDRV_PCM_HW_PARAM_FORMAT, SNDRV_PCM_FORMAT_S16_LE);
+    FIX_MASK(SNDRV_PCM_HW_PARAM_SUBFORMAT, 0);
+
+#define FIX_INTERVAL(param, val) do { \
+        p.rmask = 1u << (param); \
+        if (ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, &p) < 0) { PCM_LOG("%s: hw_refine(%s): %s", dev, #param, strerror(errno)); close(fd); return -1; } \
+        interval_exact(&p.intervals[(param) - SNDRV_PCM_HW_PARAM_FIRST_INTERVAL], (val)); \
+    } while (0)
+#define FIX_TIME(param, lo, hi) do { \
+        p.rmask = 1u << (param); \
+        if (ioctl(fd, SNDRV_PCM_IOCTL_HW_REFINE, &p) < 0) { PCM_LOG("%s: hw_refine(%s): %s", dev, #param, strerror(errno)); close(fd); return -1; } \
+        interval_open_us(&p.intervals[(param) - SNDRV_PCM_HW_PARAM_FIRST_INTERVAL], (lo), (hi)); \
+    } while (0)
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_CHANNELS, ch);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_SAMPLE_BITS, 16);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_FRAME_BITS, 32);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_RATE, rate);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_PERIOD_SIZE, period_frames);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_BUFFER_SIZE, buffer_frames);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_PERIOD_BYTES, period_frames * ch * 2);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_BUFFER_BYTES, buffer_frames * ch * 2);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_PERIODS, buffer_frames / period_frames);
+    FIX_TIME(SNDRV_PCM_HW_PARAM_PERIOD_TIME, period_frames * 1000000u / rate, period_frames * 1000000u / rate + 1u);
+    FIX_TIME(SNDRV_PCM_HW_PARAM_BUFFER_TIME, buffer_frames * 1000000u / rate, buffer_frames * 1000000u / rate + 1u);
+    FIX_INTERVAL(SNDRV_PCM_HW_PARAM_TICK_TIME, 0);
+    p.rmask = 0;
+    if (ioctl(fd, SNDRV_PCM_IOCTL_HW_PARAMS, &p) < 0) { PCM_LOG("%s: hw_params: %s", dev, strerror(errno)); close(fd); return -1; }
+
+    struct snd_pcm_sw_params s;
+    memset(&s, 0, sizeof s);
+    s.tstamp_mode = 0;
+    s.period_step = period_frames;
+    s.sleep_min = 0;
+    s.avail_min = period_frames;
+    s.xfer_align = 1;
+    s.start_threshold = 1;
+    s.stop_threshold = buffer_frames * 2;
+    s.silence_threshold = 0;
+    s.silence_size = 0;
+    s.boundary = 0x7fffffffu;
+    if (ioctl(fd, SNDRV_PCM_IOCTL_SW_PARAMS, &s) < 0) { PCM_LOG("%s: sw_params: %s", dev, strerror(errno)); close(fd); return -1; }
+    if (ioctl(fd, SNDRV_PCM_IOCTL_PREPARE) < 0) { PCM_LOG("%s: prepare: %s", dev, strerror(errno)); close(fd); return -1; }
+
+    int fl = fcntl(fd, F_GETFL);
+    fcntl(fd, F_SETFL, fl & ~O_NONBLOCK);            // the producer waits for the device
+
+    struct pcm_dev *d = calloc(1, sizeof *d);
+    d->fd = fd;
+    d->rate = rate;
+    d->ch = ch;
+    d->period = period_frames;
+    d->buffer = buffer_frames;
+    *out = d;
+    return 0;
+}
+
+void pcm_close(struct pcm_dev *d) {
+    if (!d) return;
+    if (d->fd >= 0) {
+        ioctl(d->fd, SNDRV_PCM_IOCTL_DROP);
+        close(d->fd);
+    }
+    free(d);
+}
+
+int pcm_prepare(struct pcm_dev *d) { return ioctl(d->fd, SNDRV_PCM_IOCTL_PREPARE); }
+
+int pcm_wait(struct pcm_dev *d, int timeout_ms) {
+    struct pollfd pfd = { .fd = d->fd, .events = POLLOUT };
+    int r = poll(&pfd, 1, timeout_ms);
+    if (r <= 0) return 0;
+    return (pfd.revents & POLLOUT) ? 1 : 0;
+}
+
+ssize_t pcm_write(struct pcm_dev *d, const void *buf, size_t frames) {
+    return write(d->fd, buf, frames * d->ch * 2);
+}
