diff --git a/dm/host/linux/input_evdev.c b/dm/host/linux/input_evdev.c
new file mode 100644
index 0000000..54494f9
--- /dev/null
+++ b/dm/host/linux/input_evdev.c
@@ -0,0 +1,146 @@
+#include "input_evdev.h"
+
+#include "../dm_input.h"
+
+#include <fcntl.h>
+#include <linux/input.h>
+#include <poll.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "dm_input.h"
+
+// The gamepad's layout as the pads on the street report it (the same table the Steam Deck,
+// the 8BitDo in Switch mode and the Pro Controller over USB give). A keyboard's own codes
+// map to the same buttons so a game that only needs them is playable without a pad.
+uint64_t evdev_key_buttons(uint16_t code) {
+    switch (code) {
+    case BTN_SOUTH: case KEY_ENTER: case KEY_SPACE:   return DM_BTN_A;
+    case BTN_EAST:  case KEY_ESC:   case KEY_BACKSPACE: return DM_BTN_B;
+    case BTN_NORTH: case KEY_B:      return DM_BTN_X;
+    case BTN_WEST:  case KEY_A:      return DM_BTN_Y;
+    case BTN_TL:    case KEY_Q:      return DM_BTN_L;
+    case BTN_TR:    case KEY_E:      return DM_BTN_R;
+    case BTN_TL2:   case KEY_1:      return DM_BTN_ZL;
+    case BTN_TR2:   case KEY_2:      return DM_BTN_ZR;
+    case BTN_SELECT:case KEY_TAB:    return DM_BTN_MINUS;
+    case BTN_START: case KEY_LEFTCTRL: return DM_BTN_PLUS;
+    case BTN_DPAD_LEFT:  case KEY_LEFT:  return DM_BTN_LEFT;
+    case BTN_DPAD_UP:    case KEY_UP:    return DM_BTN_UP;
+    case BTN_DPAD_RIGHT: case KEY_RIGHT: return DM_BTN_RIGHT;
+    case BTN_DPAD_DOWN:  case KEY_DOWN:  return DM_BTN_DOWN;
+    case BTN_MODE:       case KEY_M:     return DM_BTN_LS;   // stick clicks
+    case BTN_THUMBL:     case KEY_N:     return DM_BTN_RS;
+    default: return 0;
+    }
+}
+
+int evdev_abs_axis(uint16_t code) {
+    switch (code) {
+    case ABS_X: case ABS_HAT0X: return 0;
+    case ABS_Y: case ABS_HAT0Y: return 1;
+    case ABS_RX: case ABS_Z:    return 2;
+    case ABS_RY: case ABS_RZ:   return 3;
+    default: return -1;
+    }
+}
+
+int32_t evdev_abs_scale(int32_t value, int32_t min, int32_t max) {
+    if (max <= min) return 0;
+    if (value < min) value = min;
+    if (value > max) value = max;
+    int64_t v = ((int64_t)(value - min) * 65534) / (max - min) - 32767;   // the host's own ±32767
+    if (v < -32768) v = -32768;
+    if (v > 32767) v = 32767;
+    if (v > -2048 && v < 2048) v = 0;   // a small dead zone at rest, as the pads report
+    return (int32_t)v;
+}
+
+// One open device's state, published whenever it changes.
+typedef struct {
+    int fd;
+    uint64_t buttons;
+    int32_t lx, ly, rx, ry;
+    int is_pad;              // has sticks: a physical controller (dm_pad_set), not the keyboard
+    int32_t amin[4], amax[4];
+    int hat_x, hat_y;
+} dev_in;
+
+static void publish(dev_in *d) {
+    uint64_t b = d->buttons;
+    if (d->hat_x < 0) b |= DM_BTN_LEFT;  if (d->hat_x > 0) b |= DM_BTN_RIGHT;
+    if (d->hat_y < 0) b |= DM_BTN_UP;    if (d->hat_y > 0) b |= DM_BTN_DOWN;
+    if (d->is_pad) dm_pad_set(b, d->lx, d->ly, d->rx, d->ry);
+    else dm_input_set(b, d->lx, d->ly, d->rx, d->ry);
+}
+
+static void on_key(dev_in *d, uint16_t code, int32_t value) {
+    uint64_t bit = evdev_key_buttons(code);
+    if (!bit || code == BTN_DPAD_UP || code == KEY_UP) { /* hat handled below */ }
+    if (value) d->buttons |= bit; else d->buttons &= ~bit;
+    publish(d);
+}
+
+static void on_abs(dev_in *d, uint16_t code, int32_t value) {
+    int a = evdev_abs_axis(code);
+    if (a < 0 || a > 3) return;
+    if (d->amax[a] > d->amin[a]) value = evdev_abs_scale(value, d->amin[a], d->amax[a]);
+    int32_t *slot = a == 0 ? &d->lx : a == 1 ? &d->ly : a == 2 ? &d->rx : &d->ry;
+    if (a == 0 && code == ABS_HAT0X) { d->hat_x = value ? (value > 0 ? 1 : -1) : 0; publish(d); return; }
+    if (a == 1 && code == ABS_HAT0Y) { d->hat_y = value ? (value > 0 ? 1 : -1) : 0; publish(d); return; }
+    if (*slot == value) return;
+    *slot = value;
+    publish(d);
+}
+
+// The device's own ranges, read once: without them the raw -32768..32767 would be published
+// as it comes, which is fine for the pads but not for a device whose middle is not 0.
+static void read_ranges(dev_in *d) {
+    for (int a = 0; a < 4; a++) { d->amin[a] = -32768; d->amax[a] = 32767; }
+    uint16_t codes[] = { ABS_X, ABS_Y, ABS_RX, ABS_RY, ABS_Z, ABS_RZ };
+    for (unsigned i = 0; i < sizeof codes / sizeof *codes; i++) {
+        struct input_absinfo info;
+        if (ioctl(d->fd, EVIOCGABS(codes[i]), &info) < 0) continue;
+        int a = evdev_abs_axis(codes[i]);
+        if (a >= 0 && a < 4) { d->amin[a] = info.minimum; d->amax[a] = info.maximum; }
+    }
+}
+
+void evdev_read_loop(const char **paths, volatile int *stop) {
+    enum { MAXD = 16 };
+    dev_in devs[MAXD];
+    struct pollfd pfds[MAXD];
+    int n = 0;
+    for (int i = 0; paths[i] && n < MAXD; i++) {
+        int fd = open(paths[i], O_RDONLY);
+        if (fd < 0) continue;
+        uint64_t bits[2] = {0};
+        int sticks = 0;
+        if (ioctl(fd, EVIOCGBIT(EV_ABS, sizeof bits[0] * 8), bits) >= 0) sticks = bits[0] & ((1ull << ABS_X) | (1ull << ABS_RX));
+        else if (getenv("DM_INPUT_EVENTS")) sticks = 1;   // a log of events, the test's input, is a pad's stream
+        memset(&devs[n], 0, sizeof devs[n]);
+        devs[n].fd = fd;
+        devs[n].is_pad = sticks != 0;
+        read_ranges(&devs[n]);
+        pfds[n].fd = fd; pfds[n].events = POLLIN;
+        n++;
+    }
+    if (!n) return;
+    if (devs[0].is_pad) dm_pad_players(1u);   // player 1 counts as connected once a pad is open
+    while (!*stop) {
+        int r = poll(pfds, n, 200);
+        if (r <= 0) continue;
+        for (int i = 0; i < n; i++) {
+            if (!(pfds[i].revents & POLLIN)) continue;
+            struct input_event ev[8];
+            ssize_t got = read(pfds[i].fd, ev, sizeof ev);
+            if (got <= 0) continue;
+            for (ssize_t k = 0; k < got; k += sizeof ev[0]) {
+                if (ev[k / sizeof ev[0]].type == EV_KEY) on_key(&devs[i], ev[k / sizeof ev[0]].code, ev[k / sizeof ev[0]].value);
+                else if (ev[k / sizeof ev[0]].type == EV_ABS) on_abs(&devs[i], ev[k / sizeof ev[0]].code, ev[k / sizeof ev[0]].value);
+            }
+        }
+    }
+    for (int i = 0; i < n; i++) close(devs[i].fd);
+}
diff --git a/dm/host/linux/input_evdev.h b/dm/host/linux/input_evdev.h
new file mode 100644
index 0000000..e75bdde
--- /dev/null
+++ b/dm/host/linux/input_evdev.h
@@ -0,0 +1,33 @@
+// The Linux input layer: the kernel's evdev devices read straight through, with no library.
+//
+// A gamepad is /dev/input/event* with EV_KEY buttons and EV_ABS sticks (the same layout the
+// Steam Deck, the 8BitDo pads and the Switch Pro over USB expose), and the keyboard is the
+// same device with only EV_KEY. The layer maps them onto the host's own controller state
+// (dm_input.h's NpadButton bits, ±32767 sticks): a pad is player 1's physical controller
+// (dm_pad_set, as GameController is on the Mac), and a keyboard feeds the keyboard path
+// (dm_input_set) the Mac front end uses.
+//
+// The mapping table is a pure function so it can be tested without a device; the reader is
+// one thread that polls the devices it is given (DM_INPUT_DEV, or every event* on the
+// machine when it is not set).
+#ifndef DM_LINUX_INPUT_EVDEV_H
+#define DM_LINUX_INPUT_EVDEV_H
+
+#include <stdint.h>
+
+// The button bits a Linux key code means, 0 when it is not a game button the host has.
+uint64_t evdev_key_buttons(uint16_t code);
+
+// The stick axis a Linux absolute axis is: 0 = left X, 1 = left Y, 2 = right X, 3 = right Y,
+// -1 = not a stick. The hat's two axes are reported here too: the reader turns them into
+// the directional buttons.
+int evdev_abs_axis(uint16_t code);
+
+// A device's raw axis range mapped onto the host's ±32767, dead zone in the middle.
+int32_t evdev_abs_scale(int32_t value, int32_t min, int32_t max);
+
+// The reader: one thread per call, it polls the given paths (a NULL-terminated array) and
+// publishes what they report. It returns when the stop flag is set.
+void evdev_read_loop(const char **paths, volatile int *stop);
+
+#endif
diff --git a/dm/host/linux/kms_drm.c b/dm/host/linux/kms_drm.c
new file mode 100644
index 0000000..b0c5df8
--- /dev/null
+++ b/dm/host/linux/kms_drm.c
@@ -0,0 +1,343 @@
+#include "kms_drm.h"
+
+#include <errno.h>
+#include <stdint.h>
+#include <stddef.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <drm.h>
+#include <drm_mode.h>
+
+#define KMS_LOG(...) do { fprintf(stderr, "[dm] [linux] [kms] " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+#define MAX_RES 128
+#define MAX_MODES 64
+
+struct buf { uint32_t handle, fb, pitch, size; uint64_t off; void *map; };
+struct kms {
+    int fd;
+    uint32_t conn, crtc, encoder;
+    struct drm_mode_modeinfo mode;
+    struct buf buf[2];
+    int front;                 // the buffer on screen
+    int flip_pending;
+    // what the CRTC showed before, so close() hands the panel back
+    int had_crtc;
+    uint32_t old_fb, old_conns[MAX_RES], old_conn_n;
+    struct drm_mode_modeinfo old_mode;
+    unsigned w, h, hz;
+};
+
+static int find_connected(struct kms *k) {
+    struct drm_mode_card_res res;
+    memset(&res, 0, sizeof res);
+    res.connector_id_ptr = (uint64_t)(uintptr_t)calloc(MAX_RES, sizeof(uint32_t));
+    res.count_connectors = MAX_RES;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETRESOURCES, &res) < 0) { KMS_LOG("no resources: %s", strerror(errno)); free((void *)(uintptr_t)res.connector_id_ptr); return -1; }
+    uint32_t *conns = (uint32_t *)(uintptr_t)res.connector_id_ptr;
+    int best_area = -1;
+    uint32_t best = 0;
+    struct drm_mode_modeinfo best_mode;
+    memset(&best_mode, 0, sizeof best_mode);
+    for (uint32_t i = 0; i < res.count_connectors; i++) {
+        struct drm_mode_get_connector gc;
+        memset(&gc, 0, sizeof gc);
+        gc.connector_id = conns[i];
+        if (ioctl(k->fd, DRM_IOCTL_MODE_GETCONNECTOR, &gc) != 0) continue;
+        if (gc.connection != 1 || gc.count_modes == 0) continue;   // 1 = connected
+        struct drm_mode_modeinfo modes[MAX_MODES];
+        struct drm_mode_get_connector gc2 = gc;
+        gc2.modes_ptr = (uint64_t)(uintptr_t)modes;
+        gc2.count_modes = MAX_MODES;
+        gc2.props_ptr = 0; gc2.prop_values_ptr = 0; gc2.encoders_ptr = 0; gc2.count_props = 0; gc2.count_encoders = 0;
+        if (ioctl(k->fd, DRM_IOCTL_MODE_GETCONNECTOR, &gc2) != 0) continue;
+        for (uint32_t m = 0; m < gc2.count_modes; m++) {
+            if (!modes[m].clock) continue;   // a mode the kernel marks invalid has no clock
+            int area = (int)modes[m].hdisplay * modes[m].vdisplay;
+            if (area > best_area) { best_area = area; best = conns[i]; best_mode = modes[m]; }
+        }
+    }
+    if (!best) { KMS_LOG("no connector with a mode is connected"); return -1; }
+    k->conn = best;
+    k->mode = best_mode;
+    return 0;
+}
+
+static int find_crtc(struct kms *k) {
+    struct drm_mode_card_res res;
+    memset(&res, 0, sizeof res);
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETRESOURCES, &res) < 0) { KMS_LOG("resources: %s", strerror(errno)); return -1; }
+    uint32_t *crtcs = calloc(MAX_RES, sizeof(uint32_t)), *conns = calloc(MAX_RES, sizeof(uint32_t));
+    // the kernel writes every array it was told counts for: all of them get a buffer
+    res.connector_id_ptr = (uint64_t)(uintptr_t)conns;
+    res.crtc_id_ptr = (uint64_t)(uintptr_t)crtcs;
+    res.fb_id_ptr = (uint64_t)(uintptr_t)calloc(MAX_RES, sizeof(uint32_t));
+    res.encoder_id_ptr = (uint64_t)(uintptr_t)calloc(MAX_RES, sizeof(uint32_t));
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETRESOURCES, &res) < 0) {
+        KMS_LOG("resources (full): %s", strerror(errno));
+        free(crtcs); free(conns); free((void *)(uintptr_t)res.fb_id_ptr); free((void *)(uintptr_t)res.encoder_id_ptr);
+        return -1;
+    }
+    struct drm_mode_get_encoder ge;
+    memset(&ge, 0, sizeof ge);
+    // the connector's own encoder first
+    struct drm_mode_get_connector gc;
+    memset(&gc, 0, sizeof gc);
+    gc.connector_id = k->conn;
+    uint32_t enc = 0;
+    gc.encoders_ptr = (uint64_t)(uintptr_t)&enc;
+    gc.count_encoders = 1;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETCONNECTOR, &gc) == 0 && gc.count_encoders) {
+        ge.encoder_id = enc;
+        if (ioctl(k->fd, DRM_IOCTL_MODE_GETENCODER, &ge) == 0 && ge.crtc_id) k->crtc = ge.crtc_id;
+    }
+    if (!k->crtc && res.count_crtcs) k->crtc = crtcs[0];
+    free(crtcs); free(conns); free((void *)(uintptr_t)res.fb_id_ptr); free((void *)(uintptr_t)res.encoder_id_ptr);
+    if (!k->crtc) { KMS_LOG("no CRTC (conn %u, encoder's CRTC %u, card has %u)", k->conn, ge.crtc_id, res.count_crtcs); return -1; }
+    k->encoder = ge.encoder_id;
+    return 0;
+}
+
+static int make_bufs(struct kms *k) {
+    for (int i = 0; i < 2; i++) {
+        struct drm_mode_create_dumb cd;
+        memset(&cd, 0, sizeof cd);
+        cd.width = k->w; cd.height = k->h; cd.bpp = 32;
+        if (ioctl(k->fd, DRM_IOCTL_MODE_CREATE_DUMB, &cd) < 0) { KMS_LOG("dumb buffer: %s", strerror(errno)); return -1; }
+        k->buf[i].handle = cd.handle; k->buf[i].pitch = cd.pitch; k->buf[i].size = cd.size;
+        struct drm_mode_map_dumb md = { .handle = cd.handle };
+        if (ioctl(k->fd, DRM_IOCTL_MODE_MAP_DUMB, &md) < 0) { KMS_LOG("map dumb: %s", strerror(errno)); return -1; }
+        k->buf[i].off = md.offset;
+        k->buf[i].map = mmap(NULL, cd.size, PROT_READ | PROT_WRITE, MAP_SHARED, k->fd, md.offset);
+        if (k->buf[i].map == MAP_FAILED) { KMS_LOG("mmap: %s", strerror(errno)); k->buf[i].map = NULL; return -1; }
+        struct drm_mode_fb_cmd fb = { .width = k->w, .height = k->h, .pitch = cd.pitch, .bpp = 32,
+                                      .handle = cd.handle, .depth = 24 };
+        if (ioctl(k->fd, DRM_IOCTL_MODE_ADDFB, &fb) < 0) { KMS_LOG("addfb: %s", strerror(errno)); return -1; }
+        k->buf[i].fb = fb.fb_id;
+    }
+    return 0;
+}
+
+// The connectors that were feeding this CRTC, read through their encoders: the panel is
+// handed back to whoever had it, which is the only restore mode this front end promises.
+static int crtc_connectors(struct kms *k, uint32_t *out, int max) {
+    int n = 0;
+    struct drm_mode_card_res res;
+    memset(&res, 0, sizeof res);
+    res.connector_id_ptr = (uint64_t)(uintptr_t)calloc(MAX_RES, sizeof(uint32_t));
+    res.count_connectors = MAX_RES;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETRESOURCES, &res) != 0) { free((void *)(uintptr_t)res.connector_id_ptr); return 0; }
+    uint32_t *conns = (uint32_t *)(uintptr_t)res.connector_id_ptr;
+    for (uint32_t i = 0; i < res.count_connectors && n < max; i++) {
+        uint32_t enc = 0;
+        struct drm_mode_get_connector gc;
+        memset(&gc, 0, sizeof gc);
+        gc.connector_id = conns[i];
+        gc.encoders_ptr = (uint64_t)(uintptr_t)&enc;
+        gc.count_encoders = 1;
+        if (ioctl(k->fd, DRM_IOCTL_MODE_GETCONNECTOR, &gc) != 0 || !gc.count_encoders) continue;
+        struct drm_mode_get_encoder ge;
+        memset(&ge, 0, sizeof ge);
+        ge.encoder_id = enc;
+        if (ioctl(k->fd, DRM_IOCTL_MODE_GETENCODER, &ge) == 0 && ge.crtc_id == k->crtc) out[n++] = conns[i];
+    }
+    free((void *)(uintptr_t)res.connector_id_ptr);
+    return n;
+}
+
+int kms_open(struct kms **out, const char *dev) {
+    *out = NULL;
+    if (!dev || !*dev) {
+        const char *e = getenv("DM_DRM_DEV");
+        dev = e && *e ? e : NULL;
+    }
+    struct kms *k = calloc(1, sizeof *k);
+    k->fd = -1;
+    if (!dev) {
+        for (int i = 0; i < 8 && k->fd < 0; i++) {
+            char p[64];
+            snprintf(p, sizeof p, "/dev/dri/card%d", i);
+            int t = open(p, O_RDWR);
+            if (t < 0) { continue; }
+            KMS_LOG("probando %s", p);
+            k->fd = t;
+            if (find_connected(k) < 0) { k->fd = -1; close(t); continue; }   // a card with no panel to take
+        }
+        if (k->fd < 0) { KMS_LOG("no /dev/dri card takes a panel"); free(k); return -1; }
+    } else {
+        k->fd = open(dev, O_RDWR);
+        if (k->fd < 0) { KMS_LOG("%s: %s", dev, strerror(errno)); free(k); return -1; }
+        if (find_connected(k) < 0 || find_crtc(k) < 0) { kms_close(k); return -1; }
+    }
+
+    if (find_crtc(k) < 0) { kms_close(k); return -1; }   // the connector's own CRTC, or the card's first
+    k->w = k->mode.hdisplay; k->h = k->mode.vdisplay;
+    k->hz = k->mode.vrefresh ? k->mode.vrefresh : 60;
+
+    struct drm_mode_crtc cur;
+    memset(&cur, 0, sizeof cur);
+    cur.crtc_id = k->crtc;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_GETCRTC, &cur) == 0 && cur.fb_id) {
+        k->had_crtc = 1;
+        k->old_fb = cur.fb_id;
+        k->old_mode = cur.mode;
+        k->old_conn_n = crtc_connectors(k, k->old_conns, MAX_RES);
+    }
+
+    if (make_bufs(k) < 0) { kms_close(k); return -1; }
+    struct drm_mode_crtc set;
+    memset(&set, 0, sizeof set);
+    set.crtc_id = k->crtc;
+    set.fb_id = k->buf[0].fb;
+    set.set_connectors_ptr = (uint64_t)(uintptr_t)&k->conn;
+    set.count_connectors = 1;
+    set.mode = k->mode;
+    set.mode_valid = 1;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_SETCRTC, &set) < 0) { KMS_LOG("set mode %ux%u@%u: %s", k->w, k->h, k->hz, strerror(errno)); kms_close(k); return -1; }
+    k->front = 0;
+    *out = k;
+    return 0;
+}
+
+static int wait_flip(struct kms *k) {
+    while (k->flip_pending) {
+        struct pollfd pfd = { .fd = k->fd, .events = POLLIN };
+        int r = poll(&pfd, 1, 200);
+        if (r <= 0) return -1;   // the flip never completed: the caller decides
+        char buf[256];
+        ssize_t n = read(k->fd, buf, sizeof buf);
+        if (n <= 0) continue;
+        for (ssize_t i = 0; i + (ssize_t)sizeof(struct drm_event) <= n;) {
+            struct drm_event ev;
+            memcpy(&ev, buf + i, sizeof ev);
+            i += sizeof ev + ev.length;
+            if (ev.type == DRM_EVENT_FLIP_COMPLETE) k->flip_pending = 0;
+        }
+    }
+    return 0;
+}
+
+int kms_present(struct kms *k, const void *pixels) {
+    if (wait_flip(k) < 0) { KMS_LOG("the flip did not complete"); k->flip_pending = 0; return -1; }
+    int back = !k->front;
+    memcpy(k->buf[back].map, pixels, (size_t)k->w * k->h * 4);
+    struct drm_mode_crtc_page_flip pf;
+    memset(&pf, 0, sizeof pf);
+    pf.crtc_id = k->crtc;
+    pf.fb_id = k->buf[back].fb;
+    pf.flags = DRM_MODE_PAGE_FLIP_EVENT;
+    pf.user_data = (uint64_t)(uintptr_t)k;
+    pf.reserved = 0;
+    if (ioctl(k->fd, DRM_IOCTL_MODE_PAGE_FLIP, &pf) < 0) { KMS_LOG("page flip: %s", strerror(errno)); return -1; }
+    k->flip_pending = 1;
+    k->front = back;
+    return 0;
+}
+
+unsigned kms_width(const struct kms *k) { return k->w; }
+unsigned kms_height(const struct kms *k) { return k->h; }
+unsigned kms_hz(const struct kms *k) { return k->hz; }
+
+// The mode the connected panel prefers (the panel's own listed order, largest one), read
+// only: no mode setting and no DRM master, which is why a host without the master still
+// reports the real screen instead of a guess. 0 when nothing answers, and the caller keeps
+// its own default.
+static int best_connector_mode(int fd, struct drm_mode_modeinfo *best) {
+    struct drm_mode_card_res res;
+    memset(&res, 0, sizeof res);
+    res.connector_id_ptr = (uint64_t)(uintptr_t)calloc(MAX_RES, sizeof(uint32_t));
+    res.count_connectors = MAX_RES;
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res) != 0) { free((void *)(uintptr_t)res.connector_id_ptr); return 0; }
+    uint32_t *conns = (uint32_t *)(uintptr_t)res.connector_id_ptr;
+    static struct drm_mode_modeinfo modes[MAX_MODES];
+    int found = 0, best_area = -1;
+    for (uint32_t i = 0; i < res.count_connectors; i++) {
+        struct drm_mode_get_connector gc;
+        memset(&gc, 0, sizeof gc);
+        gc.connector_id = conns[i];
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &gc) != 0) continue;
+        if (gc.connection != 1 || gc.count_modes == 0) continue;
+        struct drm_mode_get_connector g2 = gc;
+        g2.modes_ptr = (uint64_t)(uintptr_t)modes;
+        g2.count_modes = MAX_MODES;
+        g2.props_ptr = 0; g2.prop_values_ptr = 0; g2.encoders_ptr = 0; g2.count_props = 0; g2.count_encoders = 0;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &g2) != 0) continue;
+        for (uint32_t m = 0; m < g2.count_modes; m++) {
+            if (!modes[m].clock) continue;
+            int area = (int)modes[m].hdisplay * modes[m].vdisplay;
+            if (area > best_area) { best_area = area; *best = modes[m]; found = 1; }
+        }
+    }
+    free((void *)(uintptr_t)res.connector_id_ptr);
+    return found;
+}
+
+int kms_probe_mode(const char *dev, unsigned *w, unsigned *h, unsigned *hz) {
+    const char *e = getenv("DM_DRM_DEV");
+    char auto_path[64] = "";
+    if (dev && *dev) { /* an explicit path wins */ }
+    else if (e && *e) dev = e;
+    else dev = NULL;
+    struct drm_mode_modeinfo mode;
+    int fd = -1;
+    for (int i = 0; i < 8; i++) {
+        char p[64];
+        snprintf(p, sizeof p, "/dev/dri/card%d", i);
+        if (dev && strcmp(dev, p) && i > 0) continue;
+        fd = open(p, O_RDWR);
+        if (fd < 0) continue;
+        if (best_connector_mode(fd, &mode)) {
+            close(fd);
+            if (w) *w = mode.hdisplay;
+            if (h) *h = mode.vdisplay;
+            if (hz) *hz = mode.vrefresh ? mode.vrefresh : 60;
+            return 1;
+        }
+        close(fd);
+        if (dev) break;   // an explicit path is not wandered from
+        (void)auto_path;
+    }
+    return 0;
+}
+
+int kms_vblank_fd(int fd, int timeout_ms) {
+    union drm_wait_vblank v;
+    memset(&v, 0, sizeof v);
+    v.request.type = (typeof(v.request.type))_DRM_VBLANK_RELATIVE;   // the next blank, not an absolute count
+    v.request.sequence = 1;
+    int r = ioctl(fd, DRM_IOCTL_WAIT_VBLANK, &v);
+    if (r < 0) { KMS_LOG("wait vblank: %s", strerror(errno)); return -1; }
+    return 0;
+}
+
+void kms_close(struct kms *k) {
+    if (!k) return;
+    if (k->fd >= 0) {
+        for (int i = 0; i < 2; i++) {
+            if (k->buf[i].map) munmap(k->buf[i].map, k->buf[i].size);
+            if (k->buf[i].fb) ioctl(k->fd, DRM_IOCTL_MODE_RMFB, &(uint32_t){k->buf[i].fb});
+            if (k->buf[i].handle) ioctl(k->fd, DRM_IOCTL_MODE_DESTROY_DUMB, &(uint32_t){k->buf[i].handle});
+        }
+        if (k->had_crtc) {
+            // hand the panel back: the CRTC as it was found, with its own geometry
+            struct drm_mode_crtc back;
+            memset(&back, 0, sizeof back);
+            back.crtc_id = k->crtc;
+            back.fb_id = k->old_fb;
+            back.mode = k->old_mode;
+            back.mode_valid = (k->old_mode.hdisplay || k->old_mode.vdisplay) ? 1 : 0;
+            back.set_connectors_ptr = (uint64_t)(uintptr_t)k->old_conns;
+            back.count_connectors = k->old_conn_n;
+            ioctl(k->fd, DRM_IOCTL_MODE_SETCRTC, &back);
+        }
+        close(k->fd);
+    }
+    free(k);
+}
diff --git a/dm/host/linux/kms_drm.h b/dm/host/linux/kms_drm.h
new file mode 100644
index 0000000..7f9e7a3
--- /dev/null
+++ b/dm/host/linux/kms_drm.h
@@ -0,0 +1,45 @@
+// The Linux front end's display: DRM/KMS straight through the kernel interface, no libdrm
+// and no window system.
+//
+// The game is a full-screen thing here, the way it is on the machine it was made for, so
+// the front end takes the panel over: one connector, one CRTC, the mode the panel prefers,
+// two dumb buffers, and a page flip per frame. The flip carries an event, and waiting for
+// it is the frame pacing the Mac front end gets from its display link: a producer that
+// presents cannot run ahead of the screen, and the flip's arrival is the frame's time.
+//
+// Everything reports instead of pretending: no device, no connected connector, a mode the
+// panel cannot take, a flip that never completes. The caller keeps its headless path when
+// that happens, as it does with no front end at all.
+#ifndef DM_LINUX_KMS_DRM_H
+#define DM_LINUX_KMS_DRM_H
+
+struct kms;
+
+// Opens the card (DM_DRM_DEV, or the first that opens) and takes the connected connector
+// with the largest mode. It remembers what the CRTC showed, and puts it back on close.
+int kms_open(struct kms **out, const char *dev);
+
+// The mode in force: pixels per frame and the rate the flips arrive at.
+unsigned kms_width(const struct kms *k);
+unsigned kms_height(const struct kms *k);
+unsigned kms_hz(const struct kms *k);
+
+// Copies one frame of XRGB8888 into the buffer the card flips to next and waits for the
+// flip. pixels is kms_width()*kms_height()*4 bytes, top to bottom, XRGB little endian.
+// 0 on success, -1 with the reason in the log.
+int kms_present(struct kms *k, const void *pixels);
+
+// The mode the panel is already showing, read only (no mode setting, no master): the front
+// end reports the screen it is really attached to instead of a guess. 0 when nothing
+// answers, and the caller keeps its own default.
+int kms_probe_mode(const char *dev, unsigned *w, unsigned *h, unsigned *hz);
+
+// The card's vertical blank: the frame clock the Mac front end gets from its display link.
+// WAIT_VBLANK needs no DRM master, so a host without the master still paces to the real
+// panel instead of a sleep that drifts. 0 when it came back, -1 on timeout or error. It
+// takes its own device handle, so it works whether or not the mode was taken over.
+int kms_vblank_fd(int fd, int timeout_ms);
+
+void kms_close(struct kms *k);
+
+#endif
