diff --git a/dm/host/linux/include/AudioToolbox/AudioToolbox.h b/dm/host/linux/include/AudioToolbox/AudioToolbox.h
new file mode 100644
index 0000000..0aa8381
--- /dev/null
+++ b/dm/host/linux/include/AudioToolbox/AudioToolbox.h
@@ -0,0 +1,91 @@
+// The CoreAudio surface the host's audio layer takes, as the Linux stand-in layer answers it.
+//
+// hle_audio.c speaks Apple's audio API: an output unit per AudioOut, a render callback the
+// unit calls to pull the game's PCM, property listeners for device and format changes. On
+// Linux the unit is a PCM device driven by a host thread (audio_au.c: the callback becomes
+// the pull inside that thread's loop), and there is no device change to listen for.
+//
+// This header carries only what hle_audio.c names. The values of the kAudio* constants are
+// the shim's own: nothing on Linux compares them against real ones.
+#ifndef DM_SHIM_AUDIOTOOLBOX_H
+#define DM_SHIM_AUDIOTOOLBOX_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef int32_t OSStatus;
+typedef uint32_t UInt32;
+typedef int32_t SInt32;
+typedef double Float64;
+typedef UInt32 AudioDeviceID;
+
+enum { noErr = 0 };
+
+typedef UInt32 AudioUnitPropertyID;
+typedef UInt32 AudioUnitScope;
+typedef UInt32 AudioUnitElement;
+typedef UInt32 AudioUnitRenderActionFlags;
+typedef struct AudioTimeStamp { double mSampleTime; uint64_t mHostTime; double mRateScalar; uint64_t mWordClockTime; void *mSMPTETime; uint32_t mFlags; uint32_t mReserved; } AudioTimeStamp;
+
+// one buffer of samples: Apple's own order is (channels, byte size, data)
+typedef struct AudioBuffer { UInt32 mNumberChannels; UInt32 mDataByteSize; void *mData; } AudioBuffer;
+typedef struct AudioBufferList { UInt32 mNumberBuffers; AudioBuffer mBuffers[2]; } AudioBufferList;
+
+typedef struct AudioValueRange { Float64 mMinimum, mMaximum; } AudioValueRange;
+
+typedef struct AudioStreamBasicDescription {
+    Float64 mSampleRate;
+    UInt32 mFormatID;
+    UInt32 mFormatFlags;
+    UInt32 mBytesPerPacket;
+    UInt32 mFramesPerPacket;
+    UInt32 mBytesPerFrame;
+    UInt32 mChannelsPerFrame;
+    UInt32 mBitsPerChannel;
+    UInt32 mReserved;
+} AudioStreamBasicDescription;
+
+typedef struct AURenderCallbackStruct {
+    OSStatus (*inputProc)(void *inRefCon, AudioUnitRenderActionFlags *ioActionFlags, const AudioTimeStamp *inTimeStamp, UInt32 inBusNumber, UInt32 inNumberFrames, AudioBufferList *ioData);
+    void *inputProcRefCtx;
+} AURenderCallbackStruct;
+
+typedef struct AudioComponentDescription {
+    UInt32 componentType, componentSubType, componentManufacturer, componentFlags;
+} AudioComponentDescription;
+
+typedef struct au_dev *AudioUnit;      // an instance, opaque to the host
+typedef const void *AudioComponent;
+
+enum {
+    kAudioUnitType_Output = 0x61756663u,
+    kAudioUnitSubType_DefaultOutput = 0x64656661u,
+    kAudioUnitSubType_RemoteIO = 0x72696f63u,
+    kAudioUnitManufacturer_Apple = 0x6170706cu,
+    kAudioObjectUnknown = 0,
+    kAudioUnitScope_Global = 0,
+    kAudioUnitScope_Input = 1,
+    kAudioUnitScope_Output = 2,
+    kAudioUnitProperty_StreamFormat = 8,
+    kAudioUnitProperty_SetRenderCallback = 37,
+    kAudioOutputUnitProperty_CurrentDevice = 0x63646576u,
+    kAudioDevicePropertyBufferFrameSize = 0x626673ffu,
+    kAudioDevicePropertyBufferFrameSizeRange = 0x626667ffu,
+    kAudioFormatLinearPCM = 0x6c70636du,
+    kLinearPCMFormatFlagIsPacked = (1u << 3),
+    kLinearPCMFormatFlagIsSignedInteger = (1u << 2),
+};
+
+AudioComponent AudioComponentFindNext(AudioComponent c, const AudioComponentDescription *d);
+OSStatus AudioComponentInstanceNew(AudioComponent c, AudioUnit *out);
+OSStatus AudioUnitInitialize(AudioUnit au);
+OSStatus AudioUnitUninitialize(AudioUnit au);
+OSStatus AudioOutputUnitStart(AudioUnit au);
+OSStatus AudioOutputUnitStop(AudioUnit au);
+OSStatus AudioUnitSetProperty(AudioUnit au, AudioUnitPropertyID id, AudioUnitScope scope, AudioUnitElement el, const void *v, UInt32 size);
+OSStatus AudioUnitGetProperty(AudioUnit au, AudioUnitPropertyID id, AudioUnitScope scope, AudioUnitElement el, void *v, UInt32 *size);
+OSStatus AudioUnitAddPropertyListener(AudioUnit au, AudioUnitPropertyID id, void (*fn)(void *, AudioUnit, AudioUnitPropertyID, AudioUnitScope, AudioUnitElement), void *ctx);
+OSStatus AudioUnitRemovePropertyListenerWithUserData(AudioUnit au, AudioUnitPropertyID id, void (*fn)(void *, AudioUnit, AudioUnitPropertyID, AudioUnitScope, AudioUnitElement), void *ctx);
+OSStatus AudioComponentInstanceDispose(AudioUnit au);
+
+#endif
