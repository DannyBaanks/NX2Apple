diff --git a/dm/host/linux/linux_tls.c b/dm/host/linux/linux_tls.c
new file mode 100644
index 0000000..70fea5c
--- /dev/null
+++ b/dm/host/linux/linux_tls.c
@@ -0,0 +1,25 @@
+// A Linux TLS-owned guest slot array. No dependence on libc's private pthread layout.
+#include <dm_linux.h>
+#include <errno.h>
+#undef pthread_setspecific
+#undef pthread_getspecific
+
+static _Thread_local uintptr_t guest_slots[1024];
+static _Thread_local unsigned char owned_slots[1024];
+
+uint64_t dm_linux_key_offset(pthread_key_t key) {
+    if ((unsigned long)key >= 1024) abort();
+    owned_slots[key] = 1;
+    return (uint64_t)((uintptr_t)&guest_slots[key] - (uintptr_t)__builtin_thread_pointer());
+}
+
+int dm_linux_setspecific(pthread_key_t key, const void *value) {
+    int rc = pthread_setspecific(key, value);
+    if (!rc && (unsigned long)key < 1024) { guest_slots[key] = (uintptr_t)value; owned_slots[key] = 1; }
+    return rc;
+}
+
+void *dm_linux_getspecific(pthread_key_t key) {
+    if ((unsigned long)key < 1024 && owned_slots[key]) return (void *)guest_slots[key];
+    return pthread_getspecific(key);
+}
diff --git a/dm/host/linux/nvn_vk.c b/dm/host/linux/nvn_vk.c
new file mode 100644
index 0000000..5946897
--- /dev/null
+++ b/dm/host/linux/nvn_vk.c
@@ -0,0 +1,811 @@
+// The NVN backend's Vulkan execution layer: the interface dm/host talks to (nvn_mtl.h),
+// answered by a real device.
+//
+// The Metal backend builds every memory pool as a zero-copy MTLBuffer whose GPU address is
+// the CPU address; a Vulkan device address is never a host pointer, so the two things this
+// layer owes the host are (a) the same zero-copy: a pool's storage is the guest's own
+// memory, imported into the device (VK_EXT_external_memory_host, which every current
+// driver has; when a driver lacks it the pool falls back to its own device memory with a
+// copy, and the log says so), and (b) the ordering rule the header states: every visible
+// effect of completion (event values, counters, a wait) happens only after the commands
+// that produce it have actually completed.
+//
+// What this is NOT: the replay layer. The 15k lines of nvn_mtl.m that turn the game's
+// NVN calls into draws are not here; the objects of nvn_obj.h are answered as the Linux
+// stub answers them until that layer lands. This is the floor under it, and it is
+// verifiable on its own: a device, a real copy between pools, a clear with a colour the
+// test can read back.
+#include "nvn_vk.h"
+
+#include "nvn_vk_builtin_spv.h"
+#include "nvn_obj.h"   // tex_t / view_t / samp_par: the interface's own object records
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vulkan/vulkan.h>
+
+#define VK_LOG(...) do { fprintf(stderr, "[dm] [linux] [vk] " __VA_ARGS__); fputc('\n', stderr); } while (0)
+
+struct gfx_vk {
+    VkInstance inst;
+    VkPhysicalDevice phys;
+    VkDevice dev;
+    VkQueue queue;
+    uint32_t qf;
+    VkCommandPool cmdpool;
+    VkFence in_flight;
+    uint64_t submit_serial, completed;      // submits issued / completed
+    int fence_pending;                     // a submission is in flight on the one fence
+    int ext_host;                           // VK_EXT_external_memory_host available
+
+    struct vkpool { const void *mem; uint64_t size; VkBuffer buf; VkDeviceMemory dmem; void *mapped; int host_imported; } pools[64];
+    int npools;
+    int said_no_ext_host;
+
+    VkCommandBuffer cmd;                    // the submission being built
+    int in_submit;
+
+    // the offscreen frame the presents go to, and the buffer the test reads it back with
+    VkImage image; VkDeviceMemory image_mem; VkImageView view;
+    VkRenderPass rp; VkFramebuffer fb; uint32_t w, h;
+    VkFormat fmt;
+    VkBuffer readback; VkDeviceMemory readback_mem; void *readback_map; VkDeviceSize readback_size;
+    uint32_t clear_color[4];                // the colour of the present, as the host sets it
+};
+
+static struct gfx_vk G;
+
+// ---- the device
+
+static uint32_t find_queue(VkPhysicalDevice phys, uint32_t want) {
+    uint32_t count = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(phys, &count, NULL);
+    VkQueueFamilyProperties *q = calloc(count ? count : 1, sizeof *q);
+    vkGetPhysicalDeviceQueueFamilyProperties(phys, &count, q);
+    uint32_t found = UINT32_MAX;
+    for (uint32_t i = 0; i < count; i++) if (q[i].queueFlags & want) { found = i; break; }
+    free(q);
+    return found;
+}
+
+static int make_instance(void) {
+    VkApplicationInfo app = { .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName = "dmhost", .apiVersion = VK_API_VERSION_1_1 };
+    VkInstanceCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app };
+    if (vkCreateInstance(&ci, NULL, &G.inst) != VK_SUCCESS) { VK_LOG("no Vulkan instance"); return -1; }
+    return 0;
+}
+
+static int make_device(void) {
+    uint32_t n = 0;
+    vkEnumeratePhysicalDevices(G.inst, &n, NULL);
+    if (!n) { VK_LOG("no Vulkan physical device"); return -1; }
+    VkPhysicalDevice *phys = calloc(n, sizeof *phys);
+    vkEnumeratePhysicalDevices(G.inst, &n, phys);
+    // The device: DM_VK_DEV picks one by a piece of its name ("llvmpipe", "radv", "NVIDIA"),
+    // which is how a software device is chosen for a test or a machine with no driver.
+    // Without it a discrete device is preferred, as the Mac front end has one; any device
+    // still runs the host, and a software one proves the same properties.
+    const char *want_dev = getenv("DM_VK_DEV");
+    int pick = -1;
+    if (want_dev && *want_dev) {
+        for (uint32_t i = 0; i < n && pick < 0; i++) {
+            VkPhysicalDeviceProperties p;
+            vkGetPhysicalDeviceProperties(phys[i], &p);
+            if (strstr(p.deviceName, want_dev)) pick = (int)i;
+        }
+        if (pick < 0) VK_LOG("no device named \"%s\": the usual pick", want_dev);
+    }
+    if (pick < 0) for (uint32_t i = 0; i < n; i++) {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(phys[i], &p);
+        if (p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) { pick = (int)i; break; }
+    }
+    if (pick < 0) pick = 0;
+    G.phys = phys[pick];
+    VkPhysicalDeviceProperties p;
+    vkGetPhysicalDeviceProperties(G.phys, &p);
+    VK_LOG("device: %s (api %u.%u.%u)", p.deviceName, VK_VERSION_MAJOR(p.apiVersion), VK_VERSION_MINOR(p.apiVersion), VK_VERSION_PATCH(p.apiVersion));
+    free(phys);
+
+    uint32_t ext_n = 0;
+    vkEnumerateDeviceExtensionProperties(G.phys, NULL, &ext_n, NULL);
+    VkExtensionProperties *ext = calloc(ext_n ? ext_n : 1, sizeof *ext);
+    vkEnumerateDeviceExtensionProperties(G.phys, NULL, &ext_n, ext);
+    const char *want[] = { VK_EXT_EXTERNAL_MEMORY_HOST_EXTENSION_NAME, VK_KHR_EXTERNAL_MEMORY_EXTENSION_NAME };
+    const char *have[2] = {0};
+    for (uint32_t i = 0; i < ext_n; i++)
+        for (int k = 0; k < 2; k++) if (!strcmp(ext[i].extensionName, want[k])) have[k] = want[k];
+    G.ext_host = have[0] != NULL;
+    VkDeviceQueueCreateInfo qci = { .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+    float prio = 1.0f;
+    G.qf = find_queue(G.phys, VK_QUEUE_GRAPHICS_BIT);
+    if (G.qf == UINT32_MAX) { VK_LOG("no graphics queue"); free(ext); return -1; }
+    qci.queueFamilyIndex = G.qf;
+    qci.queueCount = 1;
+    qci.pQueuePriorities = &prio;
+    VkDeviceCreateInfo dci = { .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+    dci.queueCreateInfoCount = 1;
+    dci.pQueueCreateInfos = &qci;
+    dci.enabledExtensionCount = 0;
+    const char *ens[2]; int ne = 0;
+    if (have[0]) ens[ne++] = have[0];
+    if (have[1] && !have[0]) ens[ne++] = have[1];
+    if (ne) { dci.enabledExtensionCount = (uint32_t)ne; dci.ppEnabledExtensionNames = ens; }
+    VkResult r = vkCreateDevice(G.phys, &dci, NULL, &G.dev);
+    free(ext);
+    if (r != VK_SUCCESS) { VK_LOG("no Vulkan device (result %d)", r); return -1; }
+    vkGetDeviceQueue(G.dev, G.qf, 0, &G.queue);
+
+    VkCommandPoolCreateInfo pci = { .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    pci.queueFamilyIndex = G.qf;
+    pci.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    if (vkCreateCommandPool(G.dev, &pci, NULL, &G.cmdpool) != VK_SUCCESS) { VK_LOG("no command pool"); return -1; }
+    VkFenceCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+    vkCreateFence(G.dev, &fci, NULL, &G.in_flight);
+    return 0;
+}
+
+// ---- memory pools: the guest's storage, imported so the device sees the same bytes
+
+static int buf_for(struct gfx_vk *g, const void *mem, uint64_t size, VkBuffer *buf, VkDeviceMemory *dmem, int host_imported);
+
+static uint32_t mem_type(const struct gfx_vk *g, uint32_t bits, VkMemoryPropertyFlags want) {
+    VkPhysicalDeviceMemoryProperties mp;
+    vkGetPhysicalDeviceMemoryProperties(g->phys, &mp);
+    for (uint32_t i = 0; i < mp.memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & want) == want) return i;
+    return UINT32_MAX;
+}
+
+void mtl_pool_add(const void *mem, uint64_t size) {
+        if (G.npools >= 64) { VK_LOG("pool table full"); return; }
+    if (mtl_addr_known((uint64_t)(uintptr_t)mem)) return;   // already known
+    struct vkpool *p = &G.pools[G.npools];
+    p->mem = mem;
+    p->size = size;
+    p->host_imported = 0;
+    const char *imp_env = getenv("DM_VK_IMPORT");
+    if (G.ext_host && (!imp_env || atoi(imp_env))) {   // the import is opt-out: a driver that hangs on it is measured with the copy
+        VkBufferCreateInfo bci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+        bci.size = size;
+        // the usages a pool's storage is bound for: the guest's vertices, indices,
+        // uniforms and storage all live in pools, so the device sees one buffer that can
+        // be bound as any of them (Metal has no such distinction)
+        bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                    VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+                    VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+        bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        if (vkCreateBuffer(G.dev, &bci, NULL, &p->buf) == VK_SUCCESS) {
+            VkMemoryRequirements mr;
+            vkGetBufferMemoryRequirements(G.dev, p->buf, &mr);
+            // import the host pointer: the device's bytes ARE the guest's bytes
+            VkImportMemoryHostPointerInfoEXT imp = { .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT };
+            imp.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+            imp.pHostPointer = (void *)mem;
+            VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .pNext = &imp };
+            ai.allocationSize = mr.size;
+            uint32_t t = mem_type(&G, mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+            if (t == UINT32_MAX) t = mem_type(&G, mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT);
+            if (t != UINT32_MAX) {
+                ai.memoryTypeIndex = t;
+                if (vkAllocateMemory(G.dev, &ai, NULL, &p->dmem) == VK_SUCCESS) {
+                    vkBindBufferMemory(G.dev, p->buf, p->dmem, 0);
+                    p->host_imported = 1;
+                    G.npools++;
+                    return;
+                }
+            }
+            vkDestroyBuffer(G.dev, p->buf, NULL);
+        }
+        if (!G.said_no_ext_host) { G.said_no_ext_host = 1; VK_LOG("external host memory refused: pools get their own device memory with a copy"); }
+    }
+    // fallback: the pool's own device memory, synchronised by the caller's map
+    if (buf_for(&G, mem, size, &p->buf, &p->dmem, 0) == 0) G.npools++;
+}
+
+void mtl_pool_del(const void *mem) {
+    for (int i = 0; i < G.npools; i++) {
+        if (G.pools[i].mem != mem) continue;
+        vkDestroyBuffer(G.dev, G.pools[i].buf, NULL);
+        vkFreeMemory(G.dev, G.pools[i].dmem, NULL);
+        G.pools[i] = G.pools[--G.npools];
+        return;
+    }
+}
+
+int mtl_addr(uint64_t addr, uint64_t len, void **buf, uint64_t *off) {
+    for (int i = 0; i < G.npools; i++) {
+        const void *m = G.pools[i].mem;
+        if (addr < (uint64_t)(uintptr_t)m) continue;
+        uint64_t d = addr - (uint64_t)(uintptr_t)m;
+        if (d > G.pools[i].size || len > G.pools[i].size - d) continue;
+        if (buf) *buf = (void *)(uintptr_t)G.pools[i].buf;
+        if (off) *off = d;
+        return 1;
+    }
+    return 0;
+}
+
+int mtl_addr_known(uint64_t addr) {
+    for (int i = 0; i < G.npools; i++) {
+        uint64_t a = addr;
+        if (a >= (uint64_t)(uintptr_t)G.pools[i].mem && a < (uint64_t)(uintptr_t)G.pools[i].mem + G.pools[i].size) return 1;
+    }
+    return 0;
+}
+
+static int buf_for(struct gfx_vk *g, const void *mem, uint64_t size, VkBuffer *buf, VkDeviceMemory *dmem, int unused) {
+    (void)mem; (void)unused;
+    VkBufferCreateInfo bci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    bci.size = size;
+    bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT |
+                VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+                VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT;
+    bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vkCreateBuffer(g->dev, &bci, NULL, buf) != VK_SUCCESS) return -1;
+    VkMemoryRequirements mr;
+    vkGetBufferMemoryRequirements(g->dev, *buf, &mr);
+    VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(g, mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX) { vkDestroyBuffer(g->dev, *buf, NULL); return -1; }
+    if (vkAllocateMemory(g->dev, &ai, NULL, dmem) != VK_SUCCESS) { vkDestroyBuffer(g->dev, *buf, NULL); return -1; }
+    vkBindBufferMemory(g->dev, *buf, *dmem, 0);
+    return 0;
+}
+
+// The pool's bytes as the host sees them: the guest's own memory when the driver imports
+// it (the same bytes the device reads), and the pool's device memory mapped when it does
+// not. NULL for a pool that is not registered.
+void *mtl_pool_ptr(const void *mem) {
+    for (int i = 0; i < G.npools; i++)
+        if (G.pools[i].mem == mem) {
+            struct vkpool *p = &G.pools[i];
+            if (p->host_imported) return (void *)p->mem;
+            if (!p->mapped) vkMapMemory(G.dev, p->dmem, 0, p->size, 0, &p->mapped);
+            return p->mapped;
+        }
+    return NULL;
+}
+
+// ---- the offscreen frame and its readback
+
+static int make_offscreen(uint32_t w, uint32_t h) {
+    if (G.image && G.w == w && G.h == h) return 0;
+    if (G.image) {
+        vkDestroyFramebuffer(G.dev, G.fb, NULL);
+        vkDestroyImageView(G.dev, G.view, NULL);
+        vkDestroyImage(G.dev, G.image, NULL);
+        vkFreeMemory(G.dev, G.image_mem, NULL);
+        G.image = NULL;
+    }
+    VkImageCreateInfo ici = { .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D;
+    ici.format = G.fmt = VK_FORMAT_R8G8B8A8_UNORM;
+    ici.extent.width = w; ici.extent.height = h; ici.extent.depth = 1;
+    ici.mipLevels = 1; ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT;
+    ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vkCreateImage(G.dev, &ici, NULL, &G.image) != VK_SUCCESS) { VK_LOG("no image"); return -1; }
+    VkMemoryRequirements mr;
+    vkGetImageMemoryRequirements(G.dev, G.image, &mr);
+    VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(&G, mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX) ai.memoryTypeIndex = mem_type(&G, mr.memoryTypeBits, 0);
+    if (vkAllocateMemory(G.dev, &ai, NULL, &G.image_mem) != VK_SUCCESS) { VK_LOG("no image memory"); return -1; }
+    vkBindImageMemory(G.dev, G.image, G.image_mem, 0);
+    VkImageViewCreateInfo vci = { .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vci.image = G.image;
+    vci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vci.format = G.fmt;
+    vci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    vci.subresourceRange.levelCount = 1;
+    vci.subresourceRange.layerCount = 1;
+    if (vkCreateImageView(G.dev, &vci, NULL, &G.view) != VK_SUCCESS) { VK_LOG("no image view"); return -1; }
+    VkAttachmentDescription att = {0};
+    att.format = G.fmt;
+    att.samples = VK_SAMPLE_COUNT_1_BIT;
+    att.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    att.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    att.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    att.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    att.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    att.finalLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    VkSubpassDescription sub = {0};
+    sub.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    VkAttachmentReference att_ref = { .attachment = 0, .layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+    sub.colorAttachmentCount = 1;
+    sub.pColorAttachments = &att_ref;
+    VkRenderPassCreateInfo rci = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO };
+    rci.attachmentCount = 1;
+    rci.pAttachments = &att;
+    rci.subpassCount = 1;
+    rci.pSubpasses = &sub;
+    if (vkCreateRenderPass(G.dev, &rci, NULL, &G.rp)) { VK_LOG("no render pass"); return -1; }
+    VkFramebufferCreateInfo fci = { .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO };
+    fci.renderPass = G.rp;
+    fci.attachmentCount = 1;
+    fci.pAttachments = &G.view;
+    fci.width = w; fci.height = h; fci.layers = 1;
+    if (vkCreateFramebuffer(G.dev, &fci, NULL, &G.fb)) { VK_LOG("no framebuffer"); return -1; }
+    G.w = w; G.h = h;
+
+    VkDeviceSize sz = (VkDeviceSize)w * h * 4;
+    VkBufferCreateInfo bci = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    bci.size = sz;
+    bci.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    if (vkCreateBuffer(G.dev, &bci, NULL, &G.readback)) { VK_LOG("no readback buffer"); return -1; }
+    vkGetBufferMemoryRequirements(G.dev, G.readback, &mr);
+    VkMemoryAllocateInfo rai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    rai.allocationSize = mr.size;
+    rai.memoryTypeIndex = mem_type(&G, mr.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (rai.memoryTypeIndex == UINT32_MAX) return -1;
+    if (vkAllocateMemory(G.dev, &rai, NULL, &G.readback_mem)) { VK_LOG("no readback memory"); return -1; }
+    vkBindBufferMemory(G.dev, G.readback, G.readback_mem, 0);
+    vkMapMemory(G.dev, G.readback_mem, 0, sz, 0, &G.readback_map);
+    G.readback_size = sz;
+    return 0;
+}
+
+void mtl_init(void) {
+    if (G.inst) { VK_LOG("already up"); return; }
+    memset(&G, 0, sizeof G);
+    G.fmt = VK_FORMAT_R8G8B8A8_UNORM;
+    G.clear_color[0] = G.clear_color[1] = G.clear_color[2] = 0;
+    G.clear_color[3] = 255;
+    // no device is not a failure of the run: the stand-in keeps answering the interface,
+    // and this line said why once
+    if (make_instance() < 0 || make_device() < 0) {
+        VK_LOG("the graphics stays on the stand-in: no device");
+        if (G.inst) { vkDestroyInstance(G.inst, NULL); G.inst = NULL; }
+        return;
+    }
+}
+
+void mtl_shutdown(void) {
+    if (!G.inst) return;
+    if (G.image) {
+        vkDestroyFramebuffer(G.dev, G.fb, NULL);
+        vkDestroyImageView(G.dev, G.view, NULL);
+        vkDestroyImage(G.dev, G.image, NULL);
+        vkFreeMemory(G.dev, G.image_mem, NULL);
+    }
+    if (G.readback) { vkUnmapMemory(G.dev, G.readback_mem); vkDestroyBuffer(G.dev, G.readback, NULL); vkFreeMemory(G.dev, G.readback_mem, NULL); }
+    for (int i = 0; i < G.npools; i++) { vkDestroyBuffer(G.dev, G.pools[i].buf, NULL); vkFreeMemory(G.dev, G.pools[i].dmem, NULL); }
+    if (G.cmdpool) vkDestroyCommandPool(G.dev, G.cmdpool, NULL);
+    if (G.in_flight) vkDestroyFence(G.dev, G.in_flight, NULL);
+    if (G.dev) vkDestroyDevice(G.dev, NULL);
+    if (G.inst) vkDestroyInstance(G.inst, NULL);
+    memset(&G, 0, sizeof G);
+}
+
+// ---- submits
+
+void mtl_sub_begin(void) {
+    if (!G.inst) return;
+    if (G.in_submit) return;
+    // the fence is unsignaled until the first submit: waiting on it then would wait for
+    // ever, so only a fence a submission left in flight is waited for
+    if (G.fence_pending) {
+        vkWaitForFences(G.dev, 1, &G.in_flight, VK_TRUE, UINT64_MAX);
+        vkResetFences(G.dev, 1, &G.in_flight);
+        G.completed = G.submit_serial;
+        G.fence_pending = 0;
+    }
+    vkResetCommandPool(G.dev, G.cmdpool, 0);
+    VkCommandBufferAllocateInfo cai = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    cai.commandPool = G.cmdpool;
+    cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    cai.commandBufferCount = 1;
+    vkAllocateCommandBuffers(G.dev, &cai, &G.cmd);
+    VkCommandBufferBeginInfo bi = { .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(G.cmd, &bi);
+    G.in_submit = 1;
+}
+
+void mtl_sub_copy(uint64_t src, uint64_t dst, uint64_t n) {
+    if (!G.inst) return;
+    void *sb = NULL, *db = NULL;
+    uint64_t so = 0, doff = 0;
+    if (!mtl_addr(src, n, &sb, &so) || !mtl_addr(dst, n, &db, &doff)) { VK_LOG("copy %#llx->%#llx (%llu): outside every pool", (unsigned long long)src, (unsigned long long)dst, (unsigned long long)n); return; }
+    VkBufferCopy region = { .srcOffset = so, .dstOffset = doff, .size = n };
+    if (!G.in_submit) mtl_sub_begin();
+    vkCmdCopyBuffer(G.cmd, (VkBuffer)sb, (VkBuffer)db, 1, &region);
+}
+
+uint64_t mtl_sub_commit(void) {
+    if (!G.inst) return 0;
+    if (!G.in_submit) return G.submit_serial;
+    vkEndCommandBuffer(G.cmd);
+    VkSubmitInfo si = { .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &G.cmd;
+    uint64_t fence = ++G.submit_serial;
+    if (vkQueueSubmit(G.queue, 1, &si, G.in_flight) != VK_SUCCESS) { VK_LOG("submit failed"); G.in_submit = 0; return 0; }
+    G.in_submit = 0;
+    G.fence_pending = 1;
+    return fence;
+}
+
+int mtl_wait(uint64_t fence) {
+    if (!G.inst) return 1;
+    if (fence <= G.completed) return 1;
+    if (fence > G.submit_serial) return 0;
+    // one fence in flight: the oldest submit is the only one that can be pending
+    VkResult wr = vkWaitForFences(G.dev, 1, &G.in_flight, VK_TRUE, 10000000000ull);   // a software device JIT-compiles on its first draw
+    if (wr != VK_SUCCESS) { VK_LOG("the fence did not signal (result %d)", wr); return 0; }
+    G.completed = G.submit_serial;
+    return G.completed >= fence;
+}
+
+void mtl_finish(void) {
+    if (!G.inst) return;
+    vkQueueWaitIdle(G.queue);
+    G.completed = G.submit_serial;
+}
+
+uint64_t mtl_completed_fence(void) { return G.completed; }
+uint64_t mtl_last_fence(void) { return G.submit_serial; }
+
+void mtl_drain(void) {
+    if (!G.inst) return;
+    mtl_sub_begin();
+    mtl_sub_commit();
+    mtl_finish();
+}
+
+// the present: the offscreen frame, cleared to the colour the host sets, and copied where
+// the caller can read it
+int mtl_offscreen_frame(uint32_t w, uint32_t h, const uint32_t rgba[4], void **pixels, size_t *bytes) {
+    if (!G.inst) return -1;
+    if (make_offscreen(w, h) < 0) return -1;
+    const uint32_t c[4] = { rgba[0], rgba[1], rgba[2], rgba[3] ? rgba[3] : 255 };
+    // an UNORM colour attachment takes its clear in floats: the kernel rejects a uint32
+    // clear for it, and the bytes that come back are the 8-bit ones
+    VkClearValue clear = { .color = { .float32 = { c[0] / 255.0f, c[1] / 255.0f, c[2] / 255.0f, c[3] / 255.0f } } };
+    mtl_sub_begin();
+    VkRenderPassBeginInfo rpbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    rpbi.renderPass = G.rp;
+    rpbi.framebuffer = G.fb;
+    rpbi.renderArea.extent.width = w;
+    rpbi.renderArea.extent.height = h;
+    rpbi.clearValueCount = 1;
+    rpbi.pClearValues = &clear;
+    vkCmdBeginRenderPass(G.cmd, &rpbi, VK_SUBPASS_CONTENTS_INLINE);
+    vkCmdEndRenderPass(G.cmd);
+    VkBufferImageCopy bic = {0};
+    bic.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    bic.imageSubresource.layerCount = 1;
+    bic.imageExtent.width = w;
+    bic.imageExtent.height = h;
+    bic.imageExtent.depth = 1;
+    vkCmdCopyImageToBuffer(G.cmd, G.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, G.readback, 1, &bic);
+    uint64_t fence = mtl_sub_commit();
+    if (!mtl_wait(fence)) { VK_LOG("the present did not complete"); return -1; }
+    if (pixels) *pixels = G.readback_map;
+    if (bytes) *bytes = (size_t)G.readback_size;
+    return 0;
+}
+
+int mtl_vk_up(void) { return G.inst != NULL; }
+
+// ---- the built-in pipeline and the frame with draws in it
+
+static VkPipeline g_pipe;
+static VkPipelineLayout g_pipe_layout;
+
+static int make_pipeline(void) {
+    if (g_pipe) return 0;
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    if (vkCreatePipelineLayout(G.dev, &plci, NULL, &g_pipe_layout) != VK_SUCCESS) { VK_LOG("no pipeline layout"); return -1; }
+    VkShaderModule vert, frag;
+    VkShaderModuleCreateInfo smci = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    smci.codeSize = DM_SPV_TRI_VERT_WORDS * 4;
+    smci.pCode = DM_SPV_TRI_VERT;
+    if (vkCreateShaderModule(G.dev, &smci, NULL, &vert) != VK_SUCCESS) { VK_LOG("no vertex module"); return -1; }
+    smci.codeSize = DM_SPV_TRI_FRAG_WORDS * 4;
+    smci.pCode = DM_SPV_TRI_FRAG;
+    if (vkCreateShaderModule(G.dev, &smci, NULL, &frag) != VK_SUCCESS) { VK_LOG("no fragment module"); vkDestroyShaderModule(G.dev, vert, NULL); return -1; }
+    VkPipelineShaderStageCreateInfo stages[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT, .module = vert, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT, .module = frag, .pName = "main" },
+    };
+    VkVertexInputBindingDescription bind = { .binding = 0, .stride = 8, .inputRate = VK_VERTEX_INPUT_RATE_VERTEX };
+    VkVertexInputAttributeDescription attr = { .location = 0, .binding = 0, .format = VK_FORMAT_R32G32_SFLOAT, .offset = 0 };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    vi.vertexBindingDescriptionCount = 1; vi.pVertexBindingDescriptions = &bind;
+    vi.vertexAttributeDescriptionCount = 1; vi.pVertexAttributeDescriptions = &attr;
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo vs = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    vs.viewportCount = 1;      // dynamic viewport and scissor: the recording sets them per frame
+    vs.scissorCount = 1;
+    VkPipelineRasterizationStateCreateInfo rs = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    rs.polygonMode = VK_POLYGON_MODE_FILL;
+    rs.cullMode = VK_CULL_MODE_NONE;
+    rs.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+    rs.lineWidth = 1.0f;
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xf };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+    cb.attachmentCount = 1;
+    cb.pAttachments = &cba;
+    VkDynamicState dyn[] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo ds = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    ds.dynamicStateCount = 2; ds.pDynamicStates = dyn;
+    VkGraphicsPipelineCreateInfo gp = { .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    gp.stageCount = 2; gp.pStages = stages;
+    gp.pVertexInputState = &vi; gp.pInputAssemblyState = &ia; gp.pViewportState = &vs;
+    gp.pRasterizationState = &rs; gp.pMultisampleState = &ms; gp.pColorBlendState = &cb;
+    gp.pDynamicState = &ds; gp.layout = g_pipe_layout; gp.renderPass = G.rp;
+    gp.basePipelineIndex = -1;
+    VkResult r = vkCreateGraphicsPipelines(G.dev, VK_NULL_HANDLE, 1, &gp, NULL, &g_pipe);
+    vkDestroyShaderModule(G.dev, vert, NULL);
+    vkDestroyShaderModule(G.dev, frag, NULL);
+    if (r != VK_SUCCESS) { VK_LOG("no pipeline (result %d)", r); return -1; }
+    return 0;
+}
+
+int mtl_offscreen_draw(uint32_t w, uint32_t h, const uint32_t clear_rgba[4],
+                       const vk_draw *draws, unsigned ndraws, void **pixels, size_t *bytes) {
+    if (!G.inst) return -1;
+    if (make_offscreen(w, h) < 0) return -1;
+    if (make_pipeline() < 0) return -1;
+    float cl[4] = { clear_rgba[0] / 255.0f, clear_rgba[1] / 255.0f, clear_rgba[2] / 255.0f, (clear_rgba[3] ? clear_rgba[3] : 255) / 255.0f };
+    VkClearValue clear = { .color = { .float32 = { cl[0], cl[1], cl[2], cl[3] } } };
+    mtl_sub_begin();
+    VkRenderPassBeginInfo rpbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    rpbi.renderPass = G.rp; rpbi.framebuffer = G.fb;
+    rpbi.renderArea.extent.width = w; rpbi.renderArea.extent.height = h;
+    rpbi.clearValueCount = 1; rpbi.pClearValues = &clear;
+    vkCmdBeginRenderPass(G.cmd, &rpbi, VK_SUBPASS_CONTENTS_INLINE);
+    vkCmdBindPipeline(G.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, g_pipe);
+    VkViewport vp = { .x = 0, .y = 0, .width = (float)w, .height = (float)h, .minDepth = 0.f, .maxDepth = 1.f };
+    vkCmdSetViewport(G.cmd, 0, 1, &vp);
+    VkRect2D sc = { .offset = {0, 0}, .extent = {w, h} };
+    vkCmdSetScissor(G.cmd, 0, 1, &sc);
+    for (unsigned i = 0; i < ndraws; i++) {
+        if (!draws[i].vbuf) continue;   // a bind that did not resolve: no host memory behind it
+        VkBuffer b = (VkBuffer)(uintptr_t)draws[i].vbuf;
+        VkDeviceSize off = draws[i].off;
+        vkCmdBindVertexBuffers(G.cmd, 0, 1, &b, &off);
+        if (draws[i].ibuf) {
+            VkIndexType it = draws[i].itype == 2 ? VK_INDEX_TYPE_UINT32 : VK_INDEX_TYPE_UINT16;
+            if (it == VK_INDEX_TYPE_UINT8_EXT) { VK_LOG("an 8-bit index draw: the built-in pipeline takes 16 or 32"); continue; }
+            vkCmdBindIndexBuffer(G.cmd, (VkBuffer)(uintptr_t)draws[i].ibuf, draws[i].ioff, it);
+            vkCmdDrawIndexed(G.cmd, draws[i].count, 1, 0, draws[i].base_vertex, 0);
+        } else {
+            vkCmdDraw(G.cmd, draws[i].count, 1, draws[i].first, 0);
+        }
+    }
+    vkCmdEndRenderPass(G.cmd);
+    VkBufferImageCopy bic = {0};
+    bic.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    bic.imageSubresource.layerCount = 1;
+    bic.imageExtent.width = w; bic.imageExtent.height = h; bic.imageExtent.depth = 1;
+    vkCmdCopyImageToBuffer(G.cmd, G.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, G.readback, 1, &bic);
+    uint64_t fence = mtl_sub_commit();
+    if (!mtl_wait(fence)) { VK_LOG("the frame did not complete"); return -1; }
+    if (pixels) *pixels = G.readback_map;
+    if (bytes) *bytes = (size_t)G.readback_size;
+    return 0;
+}
+
+int mtl_offscreen_readback(void **pixels, size_t *bytes) {
+    if (!G.inst || !G.readback_map) return -1;
+    if (pixels) *pixels = G.readback_map;
+    if (bytes) *bytes = (size_t)G.readback_size;
+    return 0;
+}
+
+// ---- textures: the guest's storage, as an image the device samples from
+//
+// A texture object (nvn_obj.h's tex_t) names its storage, and that storage lives in a pool
+// the host registered, like every other guest allocation. So an image is laid over the
+// pool's memory and the bytes are the guest's: the upload a Metal replay does is not needed
+// when the memory is the device's own (VK_IMAGE_USAGE can read host memory directly only
+// through external memory, which is the same import the pools use).
+struct vktex { uint32_t id; tex_t t; view_t v; VkImage img; VkDeviceMemory mem; VkImageView view; VkSampler samp; int ready; };
+static struct vktex g_tex[256];
+static int g_ntex;
+
+static uint32_t tex_id_of(uint32_t handle) { return (uint32_t)(handle & 0xfffffu); }   // texture ID | sampler ID << 20
+
+static VkFormat fmt_of(unsigned f) {
+    switch (f) {
+    case 2: return VK_FORMAT_R8G8B8A8_UNORM;      // RGBA8
+    case 4: return VK_FORMAT_R8_UNORM;
+    case 6: return VK_FORMAT_R8G8_UNORM;
+    case 0x18: return VK_FORMAT_B5G6R5_UNORM_PACK16;
+    default: return VK_FORMAT_UNDEFINED;
+    }
+}
+
+// The image over the texture's storage: linear, no mips beyond the first, and the sampler's
+// own parameters taken from the state the game set.
+static int tex_image(struct vktex *e) {
+    if (e->ready) return 0;
+    unsigned w = e->t.d.width ? e->t.d.width : 1, h = e->t.d.height ? e->t.d.height : 1;
+    VkFormat fmt = fmt_of(e->t.d.format);
+    if (fmt == VK_FORMAT_UNDEFINED) { VK_LOG("texture format %u: no Vulkan twin yet", e->t.d.format); return -1; }
+    void *buf = NULL; uint64_t off = 0;
+    if (!e->t.mem || !mtl_addr((uint64_t)(uintptr_t)e->t.mem + e->t.off, (uint64_t)w * h * 4, &buf, &off)) {
+        VK_LOG("a texture's storage is outside every pool");
+        return -1;
+    }
+    VkImageCreateInfo ici = { .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    ici.imageType = VK_IMAGE_TYPE_2D; ici.format = fmt;
+    ici.extent.width = w; ici.extent.height = h; ici.extent.depth = 1;
+    ici.mipLevels = 1; ici.arrayLayers = 1;
+    ici.samples = VK_SAMPLE_COUNT_1_BIT; ici.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ici.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    ici.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ici.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(G.dev, &ici, NULL, &e->img) != VK_SUCCESS) { VK_LOG("no image for the texture"); return -1; }
+    VkMemoryRequirements mr; vkGetImageMemoryRequirements(G.dev, e->img, &mr);
+    // A guest buffer is tightly packed. An image has the driver's own layout.
+    // Upload through Vulkan instead of importing the buffer as image memory.
+    VkMemoryAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(&G, mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX) ai.memoryTypeIndex = mem_type(&G, mr.memoryTypeBits, 0);
+    if (ai.memoryTypeIndex == UINT32_MAX || vkAllocateMemory(G.dev, &ai, NULL, &e->mem) != VK_SUCCESS) return -1;
+    if (vkBindImageMemory(G.dev, e->img, e->mem, 0) != VK_SUCCESS) return -1;
+    mtl_sub_begin();
+    VkImageMemoryBarrier barrier = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+        .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = e->img, .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+        .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT };
+    vkCmdPipelineBarrier(G.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                        0, 0, NULL, 0, NULL, 1, &barrier);
+    VkBufferImageCopy copy = { .bufferOffset = off,
+        .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .imageExtent = { w, h, 1 } };
+    vkCmdCopyBufferToImage(G.cmd, (VkBuffer)(uintptr_t)buf, e->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+    barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barrier.newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+    vkCmdPipelineBarrier(G.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+                        0, 0, NULL, 0, NULL, 1, &barrier);
+    if (!mtl_wait(mtl_sub_commit())) return -1;
+    VkImageViewCreateInfo vci = { .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    vci.image = e->img; vci.viewType = VK_IMAGE_VIEW_TYPE_2D; vci.format = fmt;
+    vci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    vci.subresourceRange.levelCount = 1; vci.subresourceRange.layerCount = 1;
+    if (vkCreateImageView(G.dev, &vci, NULL, &e->view) != VK_SUCCESS) { VK_LOG("no image view for the texture"); return -1; }
+    // the sampler: the parameters the game set (nvn_obj.h's samp_par), with the ones that
+    // have no twin here left at their neutral value
+    uint32_t aniso = 1;   // the sampler's aniso comes with the sampler state the record binds
+    VkSamplerCreateInfo sci = { .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+    sci.magFilter = VK_FILTER_LINEAR; sci.minFilter = VK_FILTER_LINEAR;
+    sci.addressModeU = VK_SAMPLER_ADDRESS_MODE_REPEAT;
+    sci.addressModeV = VK_SAMPLER_ADDRESS_MODE_REPEAT;
+    sci.addressModeW = VK_SAMPLER_ADDRESS_MODE_REPEAT;
+    sci.maxAnisotropy = (float)(aniso > 16 ? 16 : aniso ? aniso : 1);
+    if (vkCreateSampler(G.dev, &sci, NULL, &e->samp) != VK_SUCCESS) { VK_LOG("no sampler for the texture"); return -1; }
+    e->ready = 1;
+    return 0;
+}
+
+void mtl_reg_tex(int id, const tex_t *t, const view_t *v) {
+    if (id <= 0 || id >= 256) return;
+    struct vktex *e = &g_tex[id];
+    if (e->ready) { vkDestroySampler(G.dev, e->samp, NULL); vkDestroyImageView(G.dev, e->view, NULL); vkDestroyImage(G.dev, e->img, NULL); vkFreeMemory(G.dev, e->mem, NULL); memset(e, 0, sizeof *e); }
+    e->id = (uint32_t)id; e->t = *t; if (v) e->v = *v;
+    if ((int)e->id >= g_ntex) g_ntex = (int)e->id + 1;
+}
+
+void mtl_reg_tex_gone(int id) { mtl_reg_tex(id, &g_tex[id].t, &g_tex[id].v); }
+
+// The texture a handle names, with its image ready: NULL when it is not registered or its
+// storage is not reachable (the log said why once).
+struct vktex *vk_tex_for(uint32_t handle) {
+    uint32_t id = tex_id_of(handle);
+    if (!id || id >= 256 || g_tex[id].id != id) return NULL;
+    if (!g_tex[id].ready && tex_image(&g_tex[id]) < 0) return NULL;
+    if (!g_tex[id].ready) return NULL;
+    return &g_tex[id];
+}
+
+// ---- the textured pipeline: the same floor, with a descriptor the replay binds a
+// texture into, so a recorded frame that samples one draws it
+static VkPipeline g_pipe_tex;
+static VkPipelineLayout g_layout_tex;
+static VkDescriptorSetLayout g_dsl_tex;
+static VkDescriptorPool g_dpool_tex;
+
+static int make_pipeline_tex(void) {
+    if (g_pipe_tex) return 0;
+    VkDescriptorSetLayoutBinding b = { .binding = 0, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT };
+    VkDescriptorSetLayoutCreateInfo dlci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, .bindingCount = 1, .pBindings = &b };
+    if (vkCreateDescriptorSetLayout(G.dev, &dlci, NULL, &g_dsl_tex) != VK_SUCCESS) { VK_LOG("no descriptor layout"); return -1; }
+    VkPipelineLayoutCreateInfo plci = { .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1, .pSetLayouts = &g_dsl_tex };
+    if (vkCreatePipelineLayout(G.dev, &plci, NULL, &g_layout_tex) != VK_SUCCESS) { VK_LOG("no textured layout"); return -1; }
+    VkShaderModule vert, frag;
+    VkShaderModuleCreateInfo sm = { .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO, .codeSize = DM_SPV_TEX_VERT_WORDS * 4, .pCode = DM_SPV_TEX_VERT };
+    if (vkCreateShaderModule(G.dev, &sm, NULL, &vert) != VK_SUCCESS) { VK_LOG("no textured vertex module"); return -1; }
+    sm.codeSize = DM_SPV_TEX_FRAG_WORDS * 4; sm.pCode = DM_SPV_TEX_FRAG;
+    if (vkCreateShaderModule(G.dev, &sm, NULL, &frag) != VK_SUCCESS) { VK_LOG("no textured fragment module"); vkDestroyShaderModule(G.dev, vert, NULL); return -1; }
+    VkPipelineShaderStageCreateInfo st[2] = {
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_VERTEX_BIT, .module = vert, .pName = "main" },
+        { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_FRAGMENT_BIT, .module = frag, .pName = "main" },
+    };
+    VkVertexInputBindingDescription bind = { .binding = 0, .stride = 16, .inputRate = VK_VERTEX_INPUT_RATE_VERTEX };
+    VkVertexInputAttributeDescription attr[2] = {
+        { .location = 0, .binding = 0, .format = VK_FORMAT_R32G32_SFLOAT, .offset = 0 },
+        { .location = 1, .binding = 0, .format = VK_FORMAT_R32G32_SFLOAT, .offset = 8 },
+    };
+    VkPipelineVertexInputStateCreateInfo vi = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO, .vertexBindingDescriptionCount = 1, .pVertexBindingDescriptions = &bind, .vertexAttributeDescriptionCount = 2, .pVertexAttributeDescriptions = attr };
+    VkPipelineInputAssemblyStateCreateInfo ia = { .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO, .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST };
+    VkPipelineViewportStateCreateInfo vs = { .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO, .viewportCount = 1, .scissorCount = 1 };
+    VkPipelineRasterizationStateCreateInfo rs = { .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO, .polygonMode = VK_POLYGON_MODE_FILL, .cullMode = VK_CULL_MODE_NONE, .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE, .lineWidth = 1.f };
+    VkPipelineMultisampleStateCreateInfo ms = { .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO, .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT };
+    VkPipelineColorBlendAttachmentState cba = { .colorWriteMask = 0xf };
+    VkPipelineColorBlendStateCreateInfo cb = { .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO, .attachmentCount = 1, .pAttachments = &cba };
+    VkDynamicState dyn[] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo ds = { .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO, .dynamicStateCount = 2, .pDynamicStates = dyn };
+    VkGraphicsPipelineCreateInfo gp = { .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO, .stageCount = 2, .pStages = st, .pVertexInputState = &vi, .pInputAssemblyState = &ia, .pViewportState = &vs, .pRasterizationState = &rs, .pMultisampleState = &ms, .pColorBlendState = &cb, .pDynamicState = &ds, .layout = g_layout_tex, .renderPass = G.rp };
+    VkResult r = vkCreateGraphicsPipelines(G.dev, VK_NULL_HANDLE, 1, &gp, NULL, &g_pipe_tex);
+    vkDestroyShaderModule(G.dev, vert, NULL); vkDestroyShaderModule(G.dev, frag, NULL);
+    if (r != VK_SUCCESS) { VK_LOG("no textured pipeline (result %d)", r); return -1; }
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 8 };
+    VkDescriptorPoolCreateInfo dpci = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO, .maxSets = 8, .poolSizeCount = 1, .pPoolSizes = &ps };
+    if (vkCreateDescriptorPool(G.dev, &dpci, NULL, &g_dpool_tex) != VK_SUCCESS) { VK_LOG("no descriptor pool"); return -1; }
+    return 0;
+}
+
+// A frame in which the draws sample a texture: the draws carry the handle the recording
+// bound, the image is laid over the guest's storage, and the descriptor binds it.
+int mtl_offscreen_textured(uint32_t w, uint32_t h, const uint32_t clear_rgba[4],
+                           const vk_draw *draws, unsigned ndraws, void **pixels, size_t *bytes) {
+    if (!G.inst) return -1;
+    if (make_offscreen(w, h) < 0 || make_pipeline_tex() < 0) return -1;
+    float cl[4] = { clear_rgba[0] / 255.0f, clear_rgba[1] / 255.0f, clear_rgba[2] / 255.0f, (clear_rgba[3] ? clear_rgba[3] : 255) / 255.0f };
+    VkClearValue clear = { .color = { .float32 = { cl[0], cl[1], cl[2], cl[3] } } };
+    VkDescriptorSet sets[16] = {0};
+    for (unsigned i = 0; i < ndraws && i < 16; i++) {
+        struct vktex *t = draws[i].tex ? vk_tex_for(draws[i].tex) : NULL;
+        if (!t) { VK_LOG("draw %u carries a texture that is not registered", i); return -1; }
+        VkDescriptorSetAllocateInfo ai = { .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO, .descriptorPool = g_dpool_tex, .descriptorSetCount = 1, .pSetLayouts = &g_dsl_tex };
+        if (vkAllocateDescriptorSets(G.dev, &ai, &sets[i]) != VK_SUCCESS) { VK_LOG("no descriptor set"); return -1; }
+        VkDescriptorImageInfo di = { .sampler = t->samp, .imageView = t->view, .imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL };
+        VkWriteDescriptorSet wds = { .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = sets[i], .dstBinding = 0, .descriptorCount = 1, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .pImageInfo = &di };
+        vkUpdateDescriptorSets(G.dev, 1, &wds, 0, NULL);
+    }
+    mtl_sub_begin();
+    VkRenderPassBeginInfo rpbi = { .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO };
+    rpbi.renderPass = G.rp; rpbi.framebuffer = G.fb;
+    rpbi.renderArea.extent.width = w; rpbi.renderArea.extent.height = h;
+    rpbi.clearValueCount = 1; rpbi.pClearValues = &clear;
+    vkCmdBeginRenderPass(G.cmd, &rpbi, VK_SUBPASS_CONTENTS_INLINE);
+    vkCmdBindPipeline(G.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, g_pipe_tex);
+    VkViewport vp = { .x = 0, .y = 0, .width = (float)w, .height = (float)h, .minDepth = 0.f, .maxDepth = 1.f };
+    vkCmdSetViewport(G.cmd, 0, 1, &vp);
+    VkRect2D sc = { .offset = {0, 0}, .extent = {w, h} };
+    vkCmdSetScissor(G.cmd, 0, 1, &sc);
+    for (unsigned i = 0; i < ndraws; i++) {
+        if (!draws[i].vbuf) continue;
+        VkBuffer b = (VkBuffer)(uintptr_t)draws[i].vbuf;
+        VkDeviceSize off = draws[i].off;
+        vkCmdBindVertexBuffers(G.cmd, 0, 1, &b, &off);
+        vkCmdBindDescriptorSets(G.cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, g_layout_tex, 0, 1, &sets[i], 0, NULL);
+        vkCmdDraw(G.cmd, draws[i].count, 1, draws[i].first, 0);
+    }
+    vkCmdEndRenderPass(G.cmd);
+    VkBufferImageCopy bic; memset(&bic, 0, sizeof bic);
+    bic.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT; bic.imageSubresource.layerCount = 1;
+    bic.imageExtent.width = w; bic.imageExtent.height = h; bic.imageExtent.depth = 1;
+    vkCmdCopyImageToBuffer(G.cmd, G.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, G.readback, 1, &bic);
+    uint64_t fence = mtl_sub_commit();
+    if (!mtl_wait(fence)) { VK_LOG("the frame did not complete"); return -1; }
+    if (pixels) *pixels = G.readback_map;
+    if (bytes) *bytes = (size_t)G.readback_size;
+    return 0;
+}
diff --git a/dm/host/linux/nvn_vk.h b/dm/host/linux/nvn_vk.h
new file mode 100644
index 0000000..9ade7fc
--- /dev/null
+++ b/dm/host/linux/nvn_vk.h
@@ -0,0 +1,71 @@
+// The Vulkan execution layer of the NVN backend: the interface nvn_mtl.h names, answered by
+// a real device. Only the pieces that are verified stand here; the rest of the interface
+// (objects, textures, pipelines, the replay itself) is the Linux stand-in's to answer until
+// the replay layer lands, and the Makefile keeps exactly one of the two in the build.
+//
+// The pools: a pool's storage is the guest's own memory, imported into the device when the
+// driver has VK_EXT_external_memory_host (the same zero-copy the Metal backend gets from
+// MTLBuffer); mtl_addr maps a guest address to the buffer and offset it lives in, which is
+// the address manager the port needs. Without the extension the pool gets its own device
+// memory and the layer says so once.
+#ifndef DM_LINUX_NVN_VK_H
+#define DM_LINUX_NVN_VK_H
+
+#include <stdint.h>
+#include <stddef.h>
+
+void mtl_init(void);                    // the device (a discrete one first, any device still runs)
+void mtl_shutdown(void);
+
+void mtl_pool_add(const void *mem, uint64_t size);
+void mtl_pool_del(const void *mem);
+int mtl_addr(uint64_t addr, uint64_t len, void **buf, uint64_t *off);
+int mtl_addr_known(uint64_t addr);
+
+void mtl_sub_begin(void);
+void mtl_sub_copy(uint64_t src, uint64_t dst, uint64_t n);
+uint64_t mtl_sub_commit(void);
+uint64_t mtl_completed_fence(void);
+uint64_t mtl_last_fence(void);
+int mtl_wait(uint64_t fence);
+void mtl_finish(void);
+void mtl_drain(void);
+
+// An offscreen frame the test can read: the picture's shape, a colour, and the pixels.
+// This is the first thing the replay layer will draw through, so it exists as a function of
+// its own rather than as a present nobody can see yet.
+int mtl_offscreen_frame(uint32_t w, uint32_t h, const uint32_t rgba[4], void **pixels, size_t *bytes);
+
+// 1 once the device is up (mtl_init found one), 0 when it did not: the caller keeps the
+// stand-in answering the interface, which is what the log already said once.
+int mtl_vk_up(void);
+
+#endif
+
+// The pool's bytes as the host sees them: the guest's own memory when the driver imports
+// it, the pool's device memory mapped when it does not. NULL for an unregistered pool.
+void *mtl_pool_ptr(const void *mem);
+
+// One draw of the built-in pipeline: a vertex buffer from the guest's memory (a pool the
+// host registered) with the offset and count the recording names.
+typedef struct { void *vbuf; uint64_t off; uint32_t first, count; const void *rgba;   // a draw without indices
+                 void *ibuf; uint64_t ioff; int itype; int32_t base_vertex;   // an indexed draw
+                 uint32_t tex; } vk_draw;   // the texture handle this draw samples (0 = none)
+
+// A frame with the recorded draws in it: the clear of the offscreen frame plus each draw,
+// then the readback. The draws run in the order they were recorded.
+int mtl_offscreen_draw(uint32_t w, uint32_t h, const uint32_t clear_rgba[4],
+                       const vk_draw *draws, unsigned ndraws, void **pixels, size_t *bytes);
+
+// The pixels of the frame the layer last drew, without drawing again: the replay leaves
+// its frame there and this is how a caller reads it.
+int mtl_offscreen_readback(void **pixels, size_t *bytes);
+
+// A frame whose draws sample the textures the recording bound: the same floor as
+// mtl_offscreen_draw with a descriptor the texture is bound through.
+int mtl_offscreen_textured(uint32_t w, uint32_t h, const uint32_t clear_rgba[4],
+                           const vk_draw *draws, unsigned ndraws, void **pixels, size_t *bytes);
+
+// The texture a handle names, with its image ready: NULL when it is not registered or its
+// storage is not reachable.
+struct vktex *vk_tex_for(uint32_t handle);
diff --git a/dm/host/linux/nvn_vk_builtin_spv.h b/dm/host/linux/nvn_vk_builtin_spv.h
