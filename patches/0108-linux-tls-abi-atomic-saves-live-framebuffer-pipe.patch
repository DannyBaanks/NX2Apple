+                row[x * 3 + 2] = (uint8_t)((px >> 16) & 0xFFu);
+            }
+            fwrite(row, 1, (size_t)w * 3u, f);
+        }
+        free(row);
+    }
+    fclose(f);
+    fprintf(stderr, "[dm] [linux] [fb] screenshot written: %s (%ux%u)\n", path, w, h);
+}
+
+// ---- Command replay state ----
+typedef struct {
+    fb_tex *rt;
+    int has_vp;
+    float vp_x, vp_y, vp_w, vp_h;
+    int has_sc;
+    int32_t sc_x, sc_y, sc_w, sc_h;
+    va_st vattr[32];
+    uint32_t vstride[16];
+    NVNbufferRange vbuf[16];
+    uint32_t frag_tex_id;
+    int blend_en;
+} fb_state;
+
+static inline uint32_t blend_over(uint32_t src, uint32_t dst) {
+    uint32_t sa = (src >> 24) & 0xFFu;
+    if (sa == 255u) return src;
+    if (sa == 0u) return dst;
+    uint32_t ia = 255u - sa;
+    uint32_t r = (((src & 0xFFu) * sa) + ((dst & 0xFFu) * ia) + 127u) / 255u;
+    uint32_t g = ((((src >> 8) & 0xFFu) * sa) + (((dst >> 8) & 0xFFu) * ia) + 127u) / 255u;
+    uint32_t b = ((((src >> 16) & 0xFFu) * sa) + (((dst >> 16) & 0xFFu) * ia) + 127u) / 255u;
+    uint32_t a = sa + ((((dst >> 24) & 0xFFu) * ia) + 127u) / 255u;
+    if (a > 255u) a = 255u;
+    return r | (g << 8) | (b << 16) | (a << 24);
+}
+
+static void fb_op_copy_b2t(const p_copy_b2t *c, uint32_t rec_size) {
+    if (!c->tex || !c->src) return;
+    fb_tex *ft = fb_tex_upsert_locked(c->tex);
+    uint32_t *dst_px = fb_tex_pixels_locked(ft);
+    if (!dst_px) return;
+
+    int32_t rx = c->r.xoffset, ry = c->r.yoffset;
+    int32_t rw = c->r.width, rh = c->r.height;
+    if (rx < 0 || ry < 0 || rw <= 0 || rh <= 0) return;
+    if ((uint32_t)(rx + rw) > ft->w) rw = (int32_t)ft->w - rx;
+    if ((uint32_t)(ry + rh) > ft->h) rh = (int32_t)ft->h - ry;
+    if (rw <= 0 || rh <= 0) return;
+
+    int bw = 1, bh = 1;
+    int bpp = nvn_fmt_bpb(ft->format, &bw, &bh);
+    if (bpp <= 0 || bw != 1 || bh != 1) return;
+
+    const p_copy_strides *cs = copy_strides(c, rec_size);
+    size_t row_bytes = (cs && cs->row > 0) ? (size_t)cs->row : (size_t)rw * (size_t)bpp;
+    const uint8_t *src_base = (const uint8_t *)(uintptr_t)c->src;
+    atomic_fetch_add(&g_upload_bytes, (uint64_t)row_bytes * (uint64_t)rh);
+
+    int fmt = ft->format;
+    int force_alpha_one = (fmt == 0x6D || fmt == 0x37 || fmt == 0x99 || fmt == 0x9B);
+    int swap_rb = (fmt == 0x99 || fmt == 0x9A || fmt == 0x9B || fmt == 0x9C);
+    int fast_rgba_alpha1 = (bpp == 4 && !swap_rb && ft->set_swz && ft->swz == 0x31Au);
+    int fast_rgba_id = (bpp == 4 && !swap_rb && !force_alpha_one && (!ft->set_swz || ft->swz == 0xB1Au));
+
+    for (int32_t y = 0; y < rh; y++) {
+        const uint8_t *srow = src_base + (size_t)y * row_bytes;
+        uint32_t *drow = dst_px + (size_t)(ry + y) * ft->w + rx;
+        if (fast_rgba_id) {
+            memcpy(drow, srow, (size_t)rw * 4u);
+        } else if (fast_rgba_alpha1) {
+            const uint32_t *s32 = (const uint32_t *)srow;
+            for (int32_t x = 0; x < rw; x++) drow[x] = s32[x] | 0xFF000000u;
+        } else if (bpp == 4) {
+            const uint32_t *s32 = (const uint32_t *)srow;
+            for (int32_t x = 0; x < rw; x++) {
+                uint32_t px = s32[x];
+                if (swap_rb) px = (px & 0xFF00FF00u) | ((px & 0xFFu) << 16) | ((px >> 16) & 0xFFu);
+                if (force_alpha_one) px |= 0xFF000000u;
+                if (ft->set_swz) px = apply_swz(px, ft->swz);
+                drow[x] = px;
+            }
+        } else if (bpp == 2 && (fmt == 0x3C || fmt == 0x95)) {
+            const uint16_t *s16 = (const uint16_t *)srow;
+            for (int32_t x = 0; x < rw; x++) {
+                uint16_t v = s16[x];
+                uint8_t c0 = (uint8_t)((v & 0x1Fu) * 255u / 31u);
+                uint8_t c1 = (uint8_t)(((v >> 5) & 0x3Fu) * 255u / 63u);
+                uint8_t c2 = (uint8_t)(((v >> 11) & 0x1Fu) * 255u / 31u);
+                uint32_t px = (fmt == 0x3C)
+                    ? ((uint32_t)c0 | ((uint32_t)c1 << 8) | ((uint32_t)c2 << 16) | 0xFF000000u)
+                    : ((uint32_t)c2 | ((uint32_t)c1 << 8) | ((uint32_t)c0 << 16) | 0xFF000000u);
+                if (ft->set_swz) px = apply_swz(px, ft->swz);
+                drow[x] = px;
+            }
+        } else if (bpp == 1) {
+            for (int32_t x = 0; x < rw; x++) {
+                uint8_t v = srow[x];
+                uint32_t px = (uint32_t)v | ((uint32_t)v << 8) | ((uint32_t)v << 16) | 0xFF000000u;
+                if (ft->set_swz) px = apply_swz(px, ft->swz);
+                drow[x] = px;
+            }
+        }
+    }
+}
+
+static void fb_op_clear_color(fb_state *st, const p_clear_color *c) {
+    if (!st->rt || c->index != 0) return;
+    uint32_t *px = fb_tex_pixels_locked(st->rt);
+    if (!px) return;
+    uint8_t ch[4];
+    for (int i = 0; i < 4; i++) {
+        float v = c->rgba[i];
+        ch[i] = (uint8_t)(v <= 0.f ? 0 : v >= 1.f ? 255 : (int)(v * 255.f + 0.5f));
+    }
+    uint32_t col = (uint32_t)ch[0] | ((uint32_t)ch[1] << 8) | ((uint32_t)ch[2] << 16) | ((uint32_t)ch[3] << 24);
+
+    int32_t x0 = 0, y0 = 0, x1 = (int32_t)st->rt->w, y1 = (int32_t)st->rt->h;
+    if (st->has_sc) {
+        int32_t sx0 = st->sc_x, sx1 = st->sc_x + st->sc_w;
+        int32_t sy0 = g_origin_ll ? ((int32_t)st->rt->h - (st->sc_y + st->sc_h)) : st->sc_y;
+        int32_t sy1 = g_origin_ll ? ((int32_t)st->rt->h - st->sc_y) : (st->sc_y + st->sc_h);
+        if (sx0 > x0) x0 = sx0;
+        if (sy0 > y0) y0 = sy0;
+        if (sx1 < x1) x1 = sx1;
+        if (sy1 < y1) y1 = sy1;
+    }
+    if (x0 >= x1 || y0 >= y1) return;
+
+    if (col == 0u && x0 == 0 && x1 == (int32_t)st->rt->w) {
+        memset(px + (size_t)y0 * st->rt->w, 0, (size_t)(y1 - y0) * st->rt->w * 4u);
+        return;
+    }
+    uint32_t *first_row = px + (size_t)y0 * st->rt->w + x0;
+    size_t span = (size_t)(x1 - x0);
+    for (size_t x = 0; x < span; x++) first_row[x] = col;
+    for (int32_t y = y0 + 1; y < y1; y++) {
+        memcpy(px + (size_t)y * st->rt->w + x0, first_row, span * 4u);
+    }
+}
+
+typedef struct { float sx, sy, u, v; } fb_vert;
+
+static int fb_read_vert(const fb_state *st, uint32_t vi, fb_vert *out) {
+    va_st a0 = st->vattr[0];
+    if (a0.stream >= 16 || !st->vbuf[a0.stream].address) return 0;
+    uint32_t stride0 = st->vstride[a0.stream];
+    if (!stride0) stride0 = 16;
+    uint64_t off0 = (uint64_t)vi * stride0 + a0.offset;
+    if (off0 + 8 > st->vbuf[a0.stream].size) return 0;
+    const float *p0 = (const float *)(uintptr_t)(st->vbuf[a0.stream].address + off0);
+    float ndc_x = p0[0], ndc_y = p0[1];
+
+    float vx = st->has_vp ? st->vp_x : 0.f;
+    float vy = st->has_vp ? st->vp_y : 0.f;
+    float vw = st->has_vp ? st->vp_w : (float)st->rt->w;
+    float vh = st->has_vp ? st->vp_h : (float)st->rt->h;
+    out->sx = vx + (ndc_x * 0.5f + 0.5f) * vw;
+    float y_vp = vy + (ndc_y * 0.5f + 0.5f) * vh;
+    out->sy = g_origin_ll ? ((float)st->rt->h - y_vp) : y_vp;
+
+    out->u = 0.f; out->v = 0.f;
+    va_st a1 = st->vattr[1];
+    if (a1.fmt && a1.stream < 16 && st->vbuf[a1.stream].address) {
+        uint32_t stride1 = st->vstride[a1.stream];
+        if (!stride1) stride1 = stride0;
+        uint64_t off1 = (uint64_t)vi * stride1 + a1.offset;
+        if (off1 + 8 <= st->vbuf[a1.stream].size) {
+            const float *p1 = (const float *)(uintptr_t)(st->vbuf[a1.stream].address + off1);
+            out->u = p1[0];
+            out->v = p1[1];
+        }
+    }
+    return 1;
 }
 
+static void fb_blit_quad_fast(fb_state *st, const fb_tex *tex,
+                              float x0f, float y0f, float x1f, float y1f,
+                              float u0, float v0, float u1, float v1) {
+    uint32_t *dst_px = fb_tex_pixels_locked(st->rt);
+    if (!dst_px || !tex || !tex->rgba || !tex->w || !tex->h) return;
+    if (x1f <= x0f || y1f <= y0f) return;
+
+    int32_t clip_x0 = 0, clip_y0 = 0, clip_x1 = (int32_t)st->rt->w, clip_y1 = (int32_t)st->rt->h;
+    if (st->has_sc) {
+        int32_t sx0 = st->sc_x, sx1 = st->sc_x + st->sc_w;
+        int32_t sy0 = g_origin_ll ? ((int32_t)st->rt->h - (st->sc_y + st->sc_h)) : st->sc_y;
+        int32_t sy1 = g_origin_ll ? ((int32_t)st->rt->h - st->sc_y) : (st->sc_y + st->sc_h);
+        if (sx0 > clip_x0) clip_x0 = sx0;
+        if (sy0 > clip_y0) clip_y0 = sy0;
+        if (sx1 < clip_x1) clip_x1 = sx1;
+        if (sy1 < clip_y1) clip_y1 = sy1;
+    }
+
+    int32_t dx0 = (int32_t)floorf(x0f + 0.5f);
+    int32_t dy0 = (int32_t)floorf(y0f + 0.5f);
+    int32_t dx1 = (int32_t)floorf(x1f + 0.5f);
+    int32_t dy1 = (int32_t)floorf(y1f + 0.5f);
+    if (dx0 < clip_x0) dx0 = clip_x0;
+    if (dy0 < clip_y0) dy0 = clip_y0;
+    if (dx1 > clip_x1) dx1 = clip_x1;
+    if (dy1 > clip_y1) dy1 = clip_y1;
+    if (dx0 >= dx1 || dy0 >= dy1) return;
+
+    int32_t span = dx1 - dx0;
+    uint32_t *sx_lut = (uint32_t *)malloc((size_t)span * sizeof(uint32_t));
+    if (!sx_lut) return;
+
+    float inv_w = 1.f / (x1f - x0f);
+    float inv_h = 1.f / (y1f - y0f);
+    for (int32_t i = 0; i < span; i++) {
+        float t = ((float)(dx0 + i) + 0.5f - x0f) * inv_w;
+        float u = u0 + t * (u1 - u0);
+        int32_t sx = (int32_t)floorf(u * (float)tex->w);
+        if (sx < 0) sx = 0;
+        if (sx >= (int32_t)tex->w) sx = (int32_t)tex->w - 1;
+        sx_lut[i] = (uint32_t)sx;
+    }
+
+    int32_t prev_sy = -1;
+    uint32_t *prev_row = NULL;
+    for (int32_t y = dy0; y < dy1; y++) {
+        float t = ((float)y + 0.5f - y0f) * inv_h;
+        float v = v0 + t * (v1 - v0);
+        int32_t sy = (int32_t)floorf(v * (float)tex->h);
+        if (sy < 0) sy = 0;
+        if (sy >= (int32_t)tex->h) sy = (int32_t)tex->h - 1;
+
+        uint32_t *drow = dst_px + (size_t)y * st->rt->w + dx0;
+        if (!st->blend_en && sy == prev_sy && prev_row) {
+            memcpy(drow, prev_row, (size_t)span * 4u);
+            continue;
+        }
+        const uint32_t *srow = tex->rgba + (size_t)sy * tex->w;
+        if (!st->blend_en) {
+            for (int32_t i = 0; i < span; i++) drow[i] = srow[sx_lut[i]];
+            prev_sy = sy;
+            prev_row = drow;
+        } else {
+            for (int32_t i = 0; i < span; i++) drow[i] = blend_over(srow[sx_lut[i]], drow[i]);
+        }
+    }
+    free(sx_lut);
+}
+
+static void fb_raster_tri(fb_state *st, const fb_tex *tex, fb_vert a, fb_vert b, fb_vert c) {
+    uint32_t *dst_px = fb_tex_pixels_locked(st->rt);
+    if (!dst_px) return;
+    float area = (b.sx - a.sx) * (c.sy - a.sy) - (b.sy - a.sy) * (c.sx - a.sx);
+    if (fabsf(area) < 1e-4f) return;
+    if (area < 0.f) { fb_vert tmp = b; b = c; c = tmp; area = -area; }
+    float inv_area = 1.f / area;
+
+    int32_t minx = (int32_t)floorf(fminf(a.sx, fminf(b.sx, c.sx)));
+    int32_t maxx = (int32_t)ceilf(fmaxf(a.sx, fmaxf(b.sx, c.sx)));
+    int32_t miny = (int32_t)floorf(fminf(a.sy, fminf(b.sy, c.sy)));
+    int32_t maxy = (int32_t)ceilf(fmaxf(a.sy, fmaxf(b.sy, c.sy)));
+    if (minx < 0) minx = 0;
+    if (miny < 0) miny = 0;
+    if (maxx > (int32_t)st->rt->w) maxx = (int32_t)st->rt->w;
+    if (maxy > (int32_t)st->rt->h) maxy = (int32_t)st->rt->h;
+
+    for (int32_t y = miny; y < maxy; y++) {
+        float py = (float)y + 0.5f;
+        uint32_t *drow = dst_px + (size_t)y * st->rt->w;
+        for (int32_t x = minx; x < maxx; x++) {
+            float px = (float)x + 0.5f;
+            float w0 = ((b.sx - px) * (c.sy - py) - (b.sy - py) * (c.sx - px)) * inv_area;
+            float w1 = ((c.sx - px) * (a.sy - py) - (c.sy - py) * (a.sx - px)) * inv_area;
+            float w2 = 1.f - w0 - w1;
+            if (w0 < 0.f || w1 < 0.f || w2 < 0.f) continue;
+            uint32_t col = 0xFFFFFFFFu;
+            if (tex && tex->rgba && tex->w && tex->h) {
+                float u = w0 * a.u + w1 * b.u + w2 * c.u;
+                float v = w0 * a.v + w1 * b.v + w2 * c.v;
+                int32_t tx = (int32_t)floorf(u * (float)tex->w);
+                int32_t ty = (int32_t)floorf(v * (float)tex->h);
+                if (tx < 0) tx = 0; else if (tx >= (int32_t)tex->w) tx = (int32_t)tex->w - 1;
+                if (ty < 0) ty = 0; else if (ty >= (int32_t)tex->h) ty = (int32_t)tex->h - 1;
+                col = tex->rgba[(size_t)ty * tex->w + tx];
+            }
+            drow[x] = st->blend_en ? blend_over(col, drow[x]) : col;
+        }
+    }
+}
+
+static void fb_op_draw_common(fb_state *st, int32_t prim, int32_t first, int32_t count,
+                              const void *ibuf, int itype, int32_t base_v) {
+    if (!st->rt || count < 3) return;
+    fb_tex *tex = NULL;
+    if (st->frag_tex_id < FB_MAX_REG && g_reg[st->frag_tex_id].serial) {
+        tex = fb_tex_find_locked(g_reg[st->frag_tex_id].serial);
+    }
+    atomic_fetch_add(&g_draws, 1);
+
+    // Fast path for axis-aligned 4-vertex textured quad (TRIANGLE_STRIP=5, TRIANGLE_FAN=6, QUADS=7)
+    if (!ibuf && count == 4 && (prim == 5 || prim == 6 || prim == 7) && tex && tex->rgba) {
+        fb_vert v[4];
+        if (fb_read_vert(st, (uint32_t)first, &v[0]) &&
+            fb_read_vert(st, (uint32_t)(first + 1), &v[1]) &&
+            fb_read_vert(st, (uint32_t)(first + 2), &v[2]) &&
+            fb_read_vert(st, (uint32_t)(first + 3), &v[3])) {
+            float minx = v[0].sx, maxx = v[0].sx, miny = v[0].sy, maxy = v[0].sy;
+            for (int i = 1; i < 4; i++) {
+                if (v[i].sx < minx) minx = v[i].sx;
+                if (v[i].sx > maxx) maxx = v[i].sx;
+                if (v[i].sy < miny) miny = v[i].sy;
+                if (v[i].sy > maxy) maxy = v[i].sy;
+            }
+            int aligned = 1;
+            float u_l = 0.f, u_r = 1.f, v_t = 0.f, v_b = 1.f;
+            int got_l = 0, got_r = 0, got_t = 0, got_b = 0;
+            for (int i = 0; i < 4; i++) {
+                int at_l = fabsf(v[i].sx - minx) < 0.5f;
+                int at_r = fabsf(v[i].sx - maxx) < 0.5f;
+                int at_t = fabsf(v[i].sy - miny) < 0.5f;
+                int at_b = fabsf(v[i].sy - maxy) < 0.5f;
+                if (!(at_l || at_r) || !(at_t || at_b)) { aligned = 0; break; }
+                if (at_l && !got_l) { u_l = v[i].u; got_l = 1; }
+                if (at_r && !got_r) { u_r = v[i].u; got_r = 1; }
+                if (at_t && !got_t) { v_t = v[i].v; got_t = 1; }
+                if (at_b && !got_b) { v_b = v[i].v; got_b = 1; }
+            }
+            if (aligned && got_l && got_r && got_t && got_b) {
+                fb_blit_quad_fast(st, tex, minx, miny, maxx, maxy, u_l, v_t, u_r, v_b);
+                return;
+            }
+        }
+    }
+
+    // General triangle fallback (bounded to avoid pathological CPU stalls on large 3D meshes)
+    int32_t max_tris = 256;
+    int32_t tris = 0;
+    for (int32_t i = 0; i + 2 < count && tris < max_tris; ) {
+        uint32_t idx[3];
+        if (prim == 4) { idx[0] = (uint32_t)(first + i); idx[1] = (uint32_t)(first + i + 1); idx[2] = (uint32_t)(first + i + 2); i += 3; }
+        else if (prim == 5) { idx[0] = (uint32_t)(first + i); idx[1] = (uint32_t)(first + i + 1); idx[2] = (uint32_t)(first + i + 2); i += 1; }
+        else if (prim == 6) { idx[0] = (uint32_t)first; idx[1] = (uint32_t)(first + i + 1); idx[2] = (uint32_t)(first + i + 2); i += 1; }
+        else break;
+        if (ibuf) {
+            for (int k = 0; k < 3; k++) {
+                uint32_t raw = (itype == 1) ? ((const uint16_t *)ibuf)[idx[k]] : ((const uint32_t *)ibuf)[idx[k]];
+                idx[k] = (uint32_t)((int32_t)raw + base_v);
+            }
+        }
+        fb_vert va, vb, vc;
+        if (fb_read_vert(st, idx[0], &va) && fb_read_vert(st, idx[1], &vb) && fb_read_vert(st, idx[2], &vc))
+            fb_raster_tri(st, tex, va, vb, vc);
+        tris++;
+    }
+}
+
+static void fb_walk_locked(fb_state *st, const uint8_t *begin) {
+    const uint8_t *p = begin;
+    uint64_t steps = 0;
+    int trace = (g_trace_nvn > 0 && g_trace_frames < g_trace_nvn);
+    while (p && ++steps < 1000000) {
+        op_hdr h;
+        memcpy(&h, p, sizeof h);
+        const void *pl = p + sizeof h;
+        uint32_t pn = h.size >= sizeof h ? h.size - sizeof h : 0;
+        if (h.op == OP_END) break;
+        if (h.op == OP_JUMP && pn >= 8) {
+            uint64_t next; memcpy(&next, pl, 8);
+            p = (const uint8_t *)(uintptr_t)next;
+            continue;
+        }
+        if (h.op == OP_CALL && pn >= 8) {
+            uint64_t target; memcpy(&target, pl, 8);
+            fb_walk_locked(st, (const uint8_t *)(uintptr_t)target);
+            if (!h.size) break;
+            p += h.size;
+            continue;
+        }
+        switch (h.op) {
+        case OP_SET_RT: {
+            const p_set_rt *r = (const p_set_rt *)pl;
+            st->rt = (r->n > 0 && r->color[0]) ? fb_tex_upsert_locked(r->color[0]) : NULL;
+            if (st->rt) atomic_fetch_add(&g_passes, 1);
+            if (trace) fprintf(stderr, "[nvn-trace] SET_RT n=%d serial=%llu\n", r->n, st->rt ? (unsigned long long)st->rt->serial : 0);
+            break;
+        }
+        case OP_CLEAR_COLOR:
+            fb_op_clear_color(st, (const p_clear_color *)pl);
+            break;
+        case OP_VIEWPORTS: {
+            const p_viewports *v = (const p_viewports *)pl;
+            if (v->n > 0) {
