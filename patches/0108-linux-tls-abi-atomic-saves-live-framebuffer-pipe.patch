diff --git a/dm/tools/tests/test_linux_tls_abi.py b/dm/tools/tests/test_linux_tls_abi.py
new file mode 100644
index 0000000..bdf6731
--- /dev/null
+++ b/dm/tools/tests/test_linux_tls_abi.py
@@ -0,0 +1,24 @@
+"""Preparing an iPhone build on Linux must retain Darwin's TLS instruction."""
+import importlib.util
+import os
+from pathlib import Path
+import unittest
+from unittest import mock
+
+spec = importlib.util.spec_from_file_location('nso_asm_linux_test', Path(__file__).resolve().parents[1] / 'nso_asm.py')
+asm = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(asm)
+
+
+class HostTLS(unittest.TestCase):
+    def test_default_remains_darwin_on_every_build_machine(self):
+        with mock.patch.dict(os.environ, {}, clear=True):
+            self.assertEqual(asm.MRS_TPIDRRO(5), 0xD53BD065)
+
+    def test_explicit_linux_uses_readwrite_thread_pointer(self):
+        with mock.patch.dict(os.environ, {'DM_REWRITE_HOST': 'linux'}):
+            self.assertEqual(asm.MRS_TPIDRRO(5), 0xD53BD045)
+
+
+if __name__ == '__main__':
+    unittest.main()
