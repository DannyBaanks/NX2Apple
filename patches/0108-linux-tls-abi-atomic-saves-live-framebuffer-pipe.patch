+// The Linux audio device layer's interface (see audio_pcm.c for the protocol and the two
+// things the measurement decided). The host talks to the sound card only through here, the
+// way it talks to Mach only through the stand-ins.
+#ifndef DM_LINUX_AUDIO_PCM_H
+#define DM_LINUX_AUDIO_PCM_H
+
+#include <stddef.h>
+#include <sys/types.h>
+
+struct pcm_dev {
+    int fd;
+    unsigned rate, ch;         // the format the device was asked for
+    unsigned period, buffer;   // frames
+};
+
+// Opens the playback device at 16-bit interleaved, rate and channels. Returns 0 and a
+// handle, or -1 with the reason in the log (no device, a device that refuses the format).
+// The device is left prepared and the producer's fd in blocking mode.
+int pcm_open(struct pcm_dev **out, const char *dev, unsigned rate, unsigned ch, unsigned period_frames);
+
+void pcm_close(struct pcm_dev *d);                      // drop and close
+
+int pcm_prepare(struct pcm_dev *d);                     // after an underrun: re-arm the stream
+int pcm_wait(struct pcm_dev *d, int timeout_ms);        // 1 when the device can take frames
+ssize_t pcm_write(struct pcm_dev *d, const void *buf, size_t frames);   // blocking complete write
+
+#endif
